local btnFrame = New("Frame", {
	BackgroundColor3 = Scheme.AccentDark,
	LayoutOrder = 2,
	Size = UDim2.new(1, 0, 0, 30),
	ZIndex = window.ZIndex,
	Parent = body,
})
MakeOutline(btnFrame)

local btnLabel = New("TextLabel", {
	BackgroundTransparency = 1,
	FontFace = FONT,
	Size = UDim2.fromScale(1, 1),
	Text = t.btn,
	TextColor3 = Scheme.Font,
	TextSize = 13,
	ZIndex = btnFrame.ZIndex + 1,
	Parent = btnFrame,
})

local btnClick = New("TextButton", {
	AutoButtonColor = false,
	BackgroundTransparency = 1,
	FontFace = FONT,
	Size = UDim2.fromScale(1, 1),
	Text = "",
	ZIndex = btnFrame.ZIndex + 2,
	Parent = btnFrame,
})

btnClick.MouseEnter:Connect(function()
	TweenService:Create(btnFrame, FADE, { BackgroundColor3 = Scheme.Accent }):Play()
end)
btnClick.MouseLeave:Connect(function()
	TweenService:Create(btnFrame, FADE, { BackgroundColor3 = Scheme.AccentDark }):Play()
end)
btnClick.MouseButton1Click:Connect(function()
	pcall(function() setclipboard(DISCORD_URL) end)
	TweenService:Create(btnFrame, FADE, { BackgroundColor3 = Scheme.Green }):Play()
	btnLabel.Text = t.copied
	task.delay(2, function()
		if btnFrame and btnFrame.Parent then
			TweenService:Create(btnFrame, FADE, { BackgroundColor3 = Scheme.AccentDark }):Play()
			btnLabel.Text = t.btn
		end
	end)
end)

task.spawn(function()
	pcall(function()
		request({
			Url = "http://127.0.0.1:6463/rpc?v=1",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
			Body = HttpService:JSONEncode({
				cmd = "INVITE_BROWSER",
				nonce = HttpService:GenerateGUID(false),
				args = { code = DISCORD_CODE },
			}),
		})
	end)
end)

task.wait()
