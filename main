local subtitle = Instance.new("TextLabel")
subtitle.Name = "SubTitle"
subtitle.Parent = mainFrame
subtitle.BackgroundTransparency = 1
subtitle.Position = UDim2.new(0, 0, 0, 55)
subtitle.Size = UDim2.new(1, 0, 0, 40)
subtitle.Font = Enum.Font.Gotham
subtitle.Text = "Script loader has hit the request limit, please join the discord server to be notified when the script is back up."
subtitle.TextColor3 = Color3.fromRGB(160, 160, 160)
subtitle.TextSize = 12
subtitle.TextWrapped = true
subtitle.ZIndex = 2

local discordButton = Instance.new("TextButton")
discordButton.Name = "DiscordButton"
discordButton.Parent = mainFrame
discordButton.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
discordButton.Position = UDim2.new(0.2, 0, 0.65, 0)
discordButton.Size = UDim2.new(0.6, 0, 0, 35)
discordButton.Font = Enum.Font.GothamBold
discordButton.Text = "Copy Discord"
discordButton.TextColor3 = Color3.fromRGB(255, 255, 255)
discordButton.TextSize = 14
discordButton.ZIndex = 2

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 6)
buttonCorner.Parent = discordButton

local buttonStroke = Instance.new("UIStroke")
buttonStroke.Color = Color3.fromRGB(45, 45, 45)
buttonStroke.Thickness = 1
buttonStroke.Parent = discordButton

discordButton.MouseEnter:Connect(function()
    TweenService:Create(discordButton, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    }):Play()
end)

discordButton.MouseLeave:Connect(function()
    TweenService:Create(discordButton, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    }):Play()
end)

local isDragging = false
local dragStart = nil
local dragOffset = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        dragOffset = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
            end
        end)
    end
end)

local currentDragInput = nil
mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        currentDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == currentDragInput and isDragging then
        local delta = input.Position - dragStart
        TweenService:Create(mainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(dragOffset.X.Scale, dragOffset.X.Offset + delta.X, dragOffset.Y.Scale, dragOffset.Y.Offset + delta.Y)
        }):Play()
    end
end)

discordButton.MouseButton1Click:Connect(function()
    local opened = openDiscordInvite()
    if copyFunction then
        copyFunction(discordLink)
    end
    if opened then
        discordButton.Text = "Opening Discord..."
        task.wait(1.5)
    else
        discordButton.Text = copyFunction and "Copied!" or "Executor Not Supported"
        task.wait(1.5)
    end
    discordButton.Text = "Copy Discord"
end)

mainFrame.Size = UDim2.new(0, 0, 0, 0)
TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 340, 0, 160)
}):Play()
