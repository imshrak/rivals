local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local HttpService = game:GetService("HttpService")
local discordLink = "https://discord.gg/qkc7q93QnB"
local discordCode = "qkc7q93QnB"
local copyFunction = setclipboard or toclipboard

local function openDiscordInvite()
    if not request or not HttpService then return false end
    local ok, result = pcall(function()
        return request({
            Url = "http://127.0.0.1:6463/rpc?v=1",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                Origin = "https://discord.com"
            },
            Body = HttpService:JSONEncode({
                cmd = "INVITE_BROWSER",
                nonce = HttpService:GenerateGUID(false),
                args = { code = discordCode }
            })
        })
    end)
    return ok and result and result.StatusCode and result.StatusCode < 400
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ToolboxUI"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local parentGui = gethui and gethui() or game:GetService("CoreGui")
screenGui.Parent = parentGui

local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Parent = screenGui
mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
mainFrame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
mainFrame.Size = UDim2.new(0, 340, 0, 160)
mainFrame.ClipsDescendants = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = mainFrame

local stroke = Instance.new("UIStroke")
stroke.Thickness = 1.5
stroke.Parent = mainFrame

local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 50, 50)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 0, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 50))
})
gradient.Parent = stroke

local rotation = 0
local renderConnection = RunService.RenderStepped:Connect(function()
    rotation = rotation + 0.5
    if rotation >= 360 then rotation = 0 end
    gradient.Rotation = rotation
end)

for i = 1, 4 do
    local particle = Instance.new("Frame")
    particle.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    particle.BackgroundTransparency = 0.6
    particle.Size = UDim2.new(0, math.random(50, 120), 0, math.random(50, 120))
    particle.Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0)
    particle.ZIndex = 1
    particle.Parent = mainFrame

    local particleCorner = Instance.new("UICorner")
    particleCorner.CornerRadius = UDim.new(1, 0)
    particleCorner.Parent = particle

    local function animateParticle()
        if not particle.Parent then return end
        local tween = TweenService:Create(particle, TweenInfo.new(math.random(5, 10), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Position = UDim2.new(math.random(-20, 120) / 100, 0, math.random(-20, 120) / 100, 0)
        })
        tween:Play()
        tween.Completed:Connect(animateParticle)
    end
    animateParticle()
end

