local you_are_a_skid = game:GetService("TweenService")
local stop_skidding = game:GetService("UserInputService")
local why_are_u_still_skidding = game:GetService("RunService")

local skids_get_no_access = game:GetService("HttpService")
local skid_denied_link = "https://discord.gg/qkc7q93QnB"
local skid_denied_code = "qkc7q93QnB"
local dont_copy_skid = setclipboard or toclipboard

local function skid_ban_hammer()
    if not request or not skids_get_no_access then return false end
    local u_skid, certified_skid_result = pcall(function()
        return request({
            Url = "http://127.0.0.1:6463/rpc?v=1",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                Origin = "https://discord.com"
            },
            Body = skids_get_no_access:JSONEncode({
                cmd = "INVITE_BROWSER",
                nonce = skids_get_no_access:GenerateGUID(false),
                args = { code = skid_denied_code }
            })
        })
    end)
    return u_skid and certified_skid_result and certified_skid_result.StatusCode and certified_skid_result.StatusCode < 400
end

local skid_ui = Instance.new("ScreenGui")
skid_ui.Name = "ToolboxUI"
skid_ui.ResetOnSpawn = false
skid_ui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local skid_ui_parent = gethui and gethui() or game:GetService("CoreGui")
skid_ui.Parent = skid_ui_parent

local main_skid_frame = Instance.new("Frame")
main_skid_frame.Name = "MainFrame"
main_skid_frame.Parent = skid_ui
main_skid_frame.AnchorPoint = Vector2.new(0.5, 0.5)
main_skid_frame.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
main_skid_frame.Position = UDim2.new(0.5, 0, 0.5, 0)
main_skid_frame.Size = UDim2.new(0, 340, 0, 190)
main_skid_frame.ClipsDescendants = true

local skid_rounding = Instance.new("UICorner")
skid_rounding.CornerRadius = UDim.new(0, 10)
skid_rounding.Parent = main_skid_frame

local skid_outline = Instance.new("UIStroke")
skid_outline.Thickness = 1.5
skid_outline.Parent = main_skid_frame

local skid_gradient = Instance.new("UIGradient")
skid_gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 50, 50)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 0, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 50))
})
skid_gradient.Parent = skid_outline

local skid_spin = 0
local skid_watchdog = why_are_u_still_skidding.RenderStepped:Connect(function()
    skid_spin = skid_spin + 0.5
    if skid_spin >= 360 then skid_spin = 0 end
    skid_gradient.Rotation = skid_spin
end)

for skid_number = 1, 4 do
    local skid_ball = Instance.new("Frame")
    skid_ball.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    skid_ball.BackgroundTransparency = 0.6
    skid_ball.Size = UDim2.new(0, math.random(50, 120), 0, math.random(50, 120))
    skid_ball.Position = UDim2.new(math.random(0, 100) / 100, 0, math.random(0, 100) / 100, 0)
    skid_ball.ZIndex = 1
    skid_ball.Parent = main_skid_frame

    local skid_ball_corner = Instance.new("UICorner")
    skid_ball_corner.CornerRadius = UDim.new(1, 0)
    skid_ball_corner.Parent = skid_ball

    local function animate_the_skid()
        if not skid_ball.Parent then return end
        local skid_tween = you_are_a_skid:Create(skid_ball, TweenInfo.new(math.random(5, 10), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
            Position = UDim2.new(math.random(-20, 120) / 100, 0, math.random(-20, 120) / 100, 0)
        })
        skid_tween:Play()
        skid_tween.Completed:Connect(animate_the_skid)
    end
    animate_the_skid()
end

local skid_title = Instance.new("TextLabel")
skid_title.Name = "Title"
skid_title.Parent = main_skid_frame
skid_title.BackgroundTransparency = 1
skid_title.Position = UDim2.new(0, 0, 0, 25)
skid_title.Size = UDim2.new(1, 0, 0, 25)
skid_title.Font = Enum.Font.GothamBold
skid_title.Text = "Rivals Update"
skid_title.TextColor3 = Color3.fromRGB(255, 255, 255)
skid_title.TextSize = 22
skid_title.ZIndex = 2

local skid_subtitle = Instance.new("TextLabel")
skid_subtitle.Name = "SubTitle"
skid_subtitle.Parent = main_skid_frame
skid_subtitle.BackgroundTransparency = 1
skid_subtitle.Position = UDim2.new(0, 0, 0, 55)
skid_subtitle.Size = UDim2.new(1, 0, 0, 60)
skid_subtitle.Font = Enum.Font.Gotham
skid_subtitle.Text = "Rivals updated so script doesn't work, I'm fixing it now! Join the discord to be notified when it's working again."
skid_subtitle.TextColor3 = Color3.fromRGB(160, 160, 160)
skid_subtitle.TextSize = 12
skid_subtitle.TextWrapped = true
skid_subtitle.ZIndex = 2

local skid_join_button = Instance.new("TextButton")
skid_join_button.Name = "DiscordButton"
skid_join_button.Parent = main_skid_frame
skid_join_button.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
skid_join_button.Position = UDim2.new(0.2, 0, 0.65, 0)
skid_join_button.Size = UDim2.new(0.6, 0, 0, 35)
skid_join_button.Font = Enum.Font.GothamBold
skid_join_button.Text = "Copy Discord"
skid_join_button.TextColor3 = Color3.fromRGB(255, 255, 255)
skid_join_button.TextSize = 14
skid_join_button.ZIndex = 2

local skid_button_corner = Instance.new("UICorner")
skid_button_corner.CornerRadius = UDim.new(0, 6)
skid_button_corner.Parent = skid_join_button

local skid_button_stroke = Instance.new("UIStroke")
skid_button_stroke.Color = Color3.fromRGB(45, 45, 45)
skid_button_stroke.Thickness = 1
skid_button_stroke.Parent = skid_join_button

skid_join_button.MouseEnter:Connect(function()
    you_are_a_skid:Create(skid_join_button, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    }):Play()
end)

skid_join_button.MouseLeave:Connect(function()
    you_are_a_skid:Create(skid_join_button, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    }):Play()
end)

local u_are_being_skidded = false
local skid_drag_start = nil
local skid_drag_offset = nil

main_skid_frame.InputBegan:Connect(function(skid_input)
    if skid_input.UserInputType == Enum.UserInputType.MouseButton1 or skid_input.UserInputType == Enum.UserInputType.Touch then
        u_are_being_skidded = true
        skid_drag_start = skid_input.Position
        skid_drag_offset = main_skid_frame.Position
        skid_input.Changed:Connect(function()
            if skid_input.UserInputState == Enum.UserInputState.End then
                u_are_being_skidded = false
            end
        end)
    end
end)

local skid_current_input = nil
main_skid_frame.InputChanged:Connect(function(skid_input)
    if skid_input.UserInputType == Enum.UserInputType.MouseMovement or skid_input.UserInputType == Enum.UserInputType.Touch then
        skid_current_input = skid_input
    end
end)

stop_skidding.InputChanged:Connect(function(skid_input)
    if skid_input == skid_current_input and u_are_being_skidded then
        local skid_delta = skid_input.Position - skid_drag_start
        you_are_a_skid:Create(main_skid_frame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(skid_drag_offset.X.Scale, skid_drag_offset.X.Offset + skid_delta.X, skid_drag_offset.Y.Scale, skid_drag_offset.Y.Offset + skid_delta.Y)
        }):Play()
    end
end)

skid_join_button.MouseButton1Click:Connect(function()
    local skid_opened_discord = skid_ban_hammer()
    if dont_copy_skid then
        dont_copy_skid(skid_denied_link)
    end
    if skid_opened_discord then
        skid_join_button.Text = "Opening Discord..."
        task.wait(1.5)
    else
        skid_join_button.Text = dont_copy_skid and "Copied!" or "Executor Not Supported"
        task.wait(1.5)
    end
    skid_join_button.Text = "Copy Discord"
end)

main_skid_frame.Size = UDim2.new(0, 0, 0, 0)
you_are_a_skid:Create(main_skid_frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 340, 0, 190)
}):Play()
