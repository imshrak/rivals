local function getLocale()
	local ok, locale = pcall(function() return LocalizationService.RobloxLocaleId end)
	if ok and locale then
		local lang = locale:sub(1, 2):lower()
		if translations[lang] then return translations[lang] end
	end
	local ok2, locale2 = pcall(function() return LocalPlayer.LocaleId end)
	if ok2 and locale2 then
		local lang2 = locale2:sub(1, 2):lower()
		if translations[lang2] then return translations[lang2] end
	end
	return translations.en
end

local t = getLocale()

local function New(class, props)
	local inst = Instance.new(class)
	pcall(function() inst.BorderSizePixel = 0 end)
	for k, v in pairs(props) do
		if k ~= "Parent" then inst[k] = v end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function MakeOutline(parent)
	local outer = New("Frame", {
		BackgroundColor3 = Scheme.Dark,
		Position = UDim2.fromOffset(-1, -1),
		Size = UDim2.new(1, 2, 1, 2),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
	local inner = New("Frame", {
		BackgroundColor3 = Scheme.Outline,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = parent.ZIndex,
		Parent = outer,
	})
	return outer, inner
end

local function MakeLine(parent, y)
	return New("Frame", {
		BackgroundColor3 = Scheme.Outline,
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
end

