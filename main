local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local DISCORD_INVITE = "https://discord.gg/qkc7q93QnB"
local DISCORD_CODE = DISCORD_INVITE:match("discord%.gg/([^/?#]+)")
local environment = (type(getgenv) == "function" and getgenv()) or _G
local previous = environment.__KoraxMaintenanceState

if type(previous) == "table" then
    if previous.Loading or (typeof(previous.Gui) == "Instance" and previous.Gui.Parent) then
        return
    end
end

local state = { Loading = true }
environment.__KoraxMaintenanceState = state

local function initialize()
    local player = assert(Players.LocalPlayer, "Korax maintenance requires a client session.")
    local playerGui = assert(player:WaitForChild("PlayerGui", 10), "PlayerGui is unavailable.")
    local parent = playerGui
    local hiddenUI = gethui or get_hidden_gui
    if type(hiddenUI) == "function" then
        local success, container = pcall(hiddenUI)
        if success and typeof(container) == "Instance" then
            parent = container
        end
    end

    for _, container in ipairs({ parent, playerGui }) do
        local existing = container:FindFirstChild("KoraxMaintenance")
        if existing then
            state.Gui = existing
            state.Loading = false
            existing.Destroying:Once(function()
                if environment.__KoraxMaintenanceState == state then
                    environment.__KoraxMaintenanceState = nil
                end
            end)
            return false
        end
    end

    local colors = {
        Background = Color3.fromRGB(13, 9, 10),
        Text = Color3.fromRGB(246, 240, 241),
        Muted = Color3.fromRGB(197, 181, 184),
        Subtle = Color3.fromRGB(168, 149, 153),
        Button = Color3.fromRGB(27, 17, 19),
        Hover = Color3.fromRGB(42, 23, 27),
        Outline = Color3.fromRGB(210, 65, 80),
        Success = Color3.fromRGB(244, 151, 160),
    }

    local fades, tweens = {}, {}
    local closing = false
    local hoverTween
    local outlineTween

    state.Cleanup = function()
        for _, tween in ipairs(tweens) do
            tween:Cancel()
        end
        if hoverTween then
            hoverTween:Cancel()
        end
        if outlineTween then
            outlineTween:Cancel()
        end
        state.Loading = false
        if environment.__KoraxMaintenanceState == state then
            environment.__KoraxMaintenanceState = nil
        end
    end

    local function create(className, properties, container)
        local object = Instance.new(className)
        for property, value in pairs(properties) do
            object[property] = value
        end

        local targets = {}
        if object:IsA("GuiObject") then
            targets.BackgroundTransparency = object.BackgroundTransparency
            object.BackgroundTransparency = 1
        end
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            targets.TextTransparency = object.TextTransparency
            object.TextTransparency = 1
        elseif object:IsA("UIStroke") then
            targets.Transparency = object.Transparency
            object.Transparency = 1
        end
        if next(targets) then
            table.insert(fades, { Object = object, Targets = targets })
        end

        object.Parent = container
        return object
    end

    local function corner(object, radius)
        create("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
    end

    local function animate(object, duration, properties)
        local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
        table.insert(tweens, tween)
        tween:Play()
        return tween
    end

    local gui = create("ScreenGui", {
        Name = "KoraxMaintenance",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 1000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, nil)
    state.Gui = gui
    gui.Destroying:Connect(state.Cleanup)
    local parented = pcall(function()
        gui.Parent = parent
    end)
    if not parented then
        gui.Parent = playerGui
    end

    local root = create("Frame", {
        Name = "Backdrop",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Active = true,
    }, gui)

    local shell = create("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 10),
        Size = UDim2.fromOffset(432, 222),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, root)

    for spread = 32, 8, -8 do
        local shadow = create("Frame", {
            Name = "Shadow",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 5),
            Size = UDim2.new(1, spread * 2, 1, spread * 2),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.965,
            BorderSizePixel = 0,
            ZIndex = 1,
        }, shell)
        corner(shadow, 12 + spread)
    end

    local panel = create("Frame", {
        Name = "Panel",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = colors.Background,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, shell)
    corner(panel, 12)

    create("UIStroke", {
        Color = colors.Outline,
        Transparency = 0.18,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, panel)

    local background = create("Frame", {
        Name = "AmbientBackground",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 2,
    }, panel)
    corner(background, 12)

    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(23, 14, 16)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(11, 8, 9)),
        }),
        Rotation = 110,
    }, background)

    local function glow(name, color, origin, destination, duration)
        local holder = create("Frame", {
            Name = name,
            Position = origin,
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1,
            ZIndex = 2,
        }, background)

        for layer = 1, 24 do
            local diameter = 360 * (1 - (layer - 1) / 24)
            local ring = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(diameter, diameter),
                BackgroundColor3 = color,
                BackgroundTransparency = 0.991,
                BorderSizePixel = 0,
                ZIndex = 2,
            }, holder)
            create("UICorner", { CornerRadius = UDim.new(1, 0) }, ring)
        end

        local tween = TweenService:Create(holder, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
            Position = destination,
        })
        table.insert(tweens, tween)
        tween:Play()
    end

    glow("RedGlow", Color3.fromRGB(156, 38, 54), UDim2.fromScale(1, -0.12), UDim2.fromScale(0.82, 0.16), 7)
    glow("CrimsonGlow", Color3.fromRGB(103, 25, 38), UDim2.fromScale(-0.18, 1.1), UDim2.fromScale(0.08, 0.88), 9)

    local function resize()
        shell.Size = UDim2.fromOffset(math.max(1, math.min(432, root.AbsoluteSize.X - 40)), 222)
    end
    root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
    resize()

    local function label(name, value, y, height, font, textSize, color)
        return create("TextLabel", {
            Name = name,
            Text = value,
            Position = UDim2.fromOffset(24, y),
            Size = UDim2.new(1, -48, 0, height),
            BackgroundTransparency = 1,
            Font = font,
            TextSize = textSize,
            TextColor3 = color,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            ZIndex = 3,
        }, panel)
    end

    label("Brand", "KORAX", 20, 18, Enum.Font.SourceSansSemibold, 14, colors.Subtle)
    label("Title", "Under maintenance", 51, 34, Enum.Font.SourceSansSemibold, 28, colors.Text)
    label("Message", "Korax is temporarily unavailable.\nCheck Discord for updates.", 94, 44, Enum.Font.SourceSans, 18, colors.Muted)

    local close = create("TextButton", {
        Name = "Close",
        Text = "×",
        Position = UDim2.new(1, -46, 0, 13),
        Size = UDim2.fromOffset(32, 32),
        BackgroundColor3 = colors.Button,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.SourceSans,
        TextSize = 26,
        TextColor3 = colors.Subtle,
        ZIndex = 3,
    }, panel)
    corner(close, 6)

    create("UIStroke", {
        Color = colors.Outline,
        Transparency = 0.7,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, close)

    local copyInvite = create("TextButton", {
        Name = "CopyDiscordInvite",
        Text = "Copy Discord invite",
        Position = UDim2.fromOffset(24, 158),
        Size = UDim2.new(1, -48, 0, 40),
        BackgroundColor3 = colors.Button,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.SourceSansSemibold,
        TextSize = 18,
        TextColor3 = colors.Text,
        ZIndex = 3,
    }, panel)
    corner(copyInvite, 7)

    local buttonOutline = create("UIStroke", {
        Color = colors.Outline,
        Transparency = 0.35,
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, copyInvite)

    local function buttonHover(color, transparency)
        if closing then
            return
        end
        if hoverTween then
            hoverTween:Cancel()
        end
        if outlineTween then
            outlineTween:Cancel()
        end
        hoverTween = TweenService:Create(copyInvite, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = color,
        })
        outlineTween = TweenService:Create(buttonOutline, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Transparency = transparency,
        })
        hoverTween:Play()
        outlineTween:Play()
    end

    copyInvite.MouseEnter:Connect(function()
        buttonHover(colors.Hover, 0.05)
    end)
    copyInvite.MouseLeave:Connect(function()
        buttonHover(colors.Button, 0.35)
    end)
    close.MouseEnter:Connect(function()
        if not closing then
            close.TextColor3 = colors.Text
        end
    end)
    close.MouseLeave:Connect(function()
        close.TextColor3 = colors.Subtle
    end)

    local copyVersion = 0
    copyInvite.Activated:Connect(function()
        if closing then
            return
        end
        copyVersion = copyVersion + 1
        local version = copyVersion
        local clipboard = setclipboard or toclipboard or (syn and syn.write_clipboard)
        local copied = false

        if type(clipboard) == "function" then
            local success, result = pcall(clipboard, DISCORD_INVITE)
            copied = success and result ~= false
        end

        copyInvite.Text = copied and "Invite copied" or "Clipboard unavailable"
        copyInvite.TextColor3 = copied and colors.Success or colors.Text
        task.delay(2, function()
            if gui.Parent and not closing and copyVersion == version then
                copyInvite.Text = "Copy Discord invite"
                copyInvite.TextColor3 = colors.Text
            end
        end)
    end)

    close.Activated:Connect(function()
        if closing then
            return
        end
        closing = true
        for _, tween in ipairs(tweens) do
            tween:Cancel()
        end
        if hoverTween then
            hoverTween:Cancel()
        end
        if outlineTween then
            outlineTween:Cancel()
        end
        for _, entry in ipairs(fades) do
            local targets = {}
            for property in pairs(entry.Targets) do
                targets[property] = 1
            end
            animate(entry.Object, 0.18, targets)
        end
        local exit = animate(shell, 0.18, { Position = UDim2.new(0.5, 0, 0.5, 8) })
        exit.Completed:Once(function()
            gui:Destroy()
        end)
    end)

    for _, entry in ipairs(fades) do
        animate(entry.Object, 0.3, entry.Targets)
    end
    animate(shell, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
    return true
end

local success, created = xpcall(initialize, function(message)
    return tostring(message)
end)

if not success then
    if state.Cleanup then
        state.Cleanup()
    end
    if state.Gui then
        state.Gui:Destroy()
    end
    if environment.__KoraxMaintenanceState == state then
        environment.__KoraxMaintenanceState = nil
    end
    warn("[Korax] " .. created)
    return
end

state.Loading = false
if not created then
    return
end

local sendRequest = request or http_request or (syn and syn.request)
if type(sendRequest) == "function" then
    task.spawn(function()
        pcall(function()
            sendRequest({
                Url = "http://127.0.0.1:6463/rpc?v=1",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    Origin = "https://discord.com",
                },
                Body = HttpService:JSONEncode({
                    cmd = "INVITE_BROWSER",
                    nonce = HttpService:GenerateGUID(false),
                    args = { code = DISCORD_CODE },
                }),
            })
        end)
    end)
end
