-- Bro come on, its free and keyless really?
pcall(function() loadstring(game:HttpGet("https://scriptblox.com/ingest/clientv2.lua"))("proj_5e3f2ebd0223", "1.0.0", false) end)
do
    if not game:IsLoaded() then game.Loaded:Wait() end

    local env = _G
    if type(getgenv) == "function" then
        local ok, environment = pcall(getgenv)
        if ok and type(environment) == "table" then env = environment end
    end

    local inviteCode = "qkc7q93QnB"
    local inviteURL = "https://discord.gg/" .. inviteCode
    local function openDiscordInvite()
        task.spawn(function()
            local ok, err = pcall(function()
                local HttpService = game:GetService("HttpService")
                request({
                    Url = "http://127.0.0.1:6463/rpc?v=1",
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        Origin = "https://discord.com",
                    },
                    Body = HttpService:JSONEncode({
                        cmd = "INVITE_BROWSER",
                        nonce = HttpService:GenerateGUID(false),
                        args = { code = inviteCode },
                    }),
                })
            end)
            if not ok then warn("[Korax] Discord invite could not be opened: " .. tostring(err)) end
        end)
    end

    local function showStartupNotice(titleText, messageText)
        if env.__KoraxUpdateNoticeCleanup then env.__KoraxUpdateNoticeCleanup() end
        local screen = Instance.new("ScreenGui")
        local attached = false
        if type(gethui) == "function" then
            attached = pcall(function() screen.Parent = gethui() end)
            attached = attached and screen.Parent ~= nil
        end
        if not attached then
            attached = pcall(function() screen.Parent = game:GetService("CoreGui") end)
        end
        if not attached then
            local players = game:GetService("Players")
            while not players.LocalPlayer do
                players:GetPropertyChangedSignal("LocalPlayer"):Wait()
            end
            screen.Parent = players.LocalPlayer:WaitForChild("PlayerGui")
        end
        local parent = screen.Parent
        local previous = parent:FindFirstChild("KoraxUpdateNotice")
        if previous then previous:Destroy() end
        local TweenService = game:GetService("TweenService")
        local RunService = game:GetService("RunService")
        local UserInputService = game:GetService("UserInputService")
        local TextService = game:GetService("TextService")
        local theme = {
            Font = Font.fromEnum(Enum.Font.BuilderSans),
            Main = Color3.fromRGB(17, 17, 17),
            Background = Color3.fromRGB(22, 22, 22),
            Outline = Color3.fromRGB(35, 35, 35),
            Text = Color3.fromRGB(242, 242, 242),
            Accent = Color3.fromRGB(244, 244, 245),
        }

        screen.Name = "KoraxUpdateNotice"
        screen.ResetOnSpawn = false
        screen.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
        screen.ClipToDeviceSafeArea = true
        screen.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None
        screen.DisplayOrder = 2147483647
        screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        local backdrop = Instance.new("Frame")
        backdrop.Name = "Backdrop"
        backdrop.Size = UDim2.fromScale(1, 1)
        backdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        backdrop.BackgroundTransparency = 1
        backdrop.BorderSizePixel = 0
        backdrop.Active = true
        backdrop.Parent = screen

        local card = Instance.new("Frame")
        card.Name = "Card"
        card.Size = UDim2.fromOffset(380, 0)
        card.BackgroundColor3 = theme.Main
        card.BorderSizePixel = 0
        card.Visible = false
        card.Parent = backdrop

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = card
        local stroke = Instance.new("UIStroke")
        stroke.Color = theme.Outline
        stroke.Transparency = 0
        stroke.Thickness = 1
        stroke.Parent = card
        local mediumFont = Font.new(theme.Font.Family, Enum.FontWeight.Medium, theme.Font.Style)
        local headingFont = Font.new(theme.Font.Family, Enum.FontWeight.SemiBold, theme.Font.Style)
        local content = Instance.new("ScrollingFrame")
        content.Name = "Content"
        content.BackgroundTransparency = 1
        content.BorderSizePixel = 0
        content.Active = true
        content.CanvasSize = UDim2.fromOffset(0, 0)
        content.AutomaticCanvasSize = Enum.AutomaticSize.Y
        content.ScrollingDirection = Enum.ScrollingDirection.Y
        content.ScrollBarThickness = 0
        content.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 108)
        content.Parent = card

        local title = Instance.new("TextLabel")
        title.Name = "Title"
        title.LayoutOrder = 1
        title.Size = UDim2.new(1, -6, 0, 0)
        title.AutomaticSize = Enum.AutomaticSize.Y
        title.BackgroundTransparency = 1
        title.FontFace = headingFont
        title.TextSize = 19
        title.TextColor3 = theme.Text
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextYAlignment = Enum.TextYAlignment.Top
        title.TextWrapped = true
        title.Text = titleText
        title.Active = true
        title.Parent = card

        local message = Instance.new("TextLabel")
        message.Name = "Message"
        message.LayoutOrder = 1
        message.Size = UDim2.new(1, -6, 0, 0)
        message.BackgroundTransparency = 1
        message.FontFace = theme.Font
        message.TextSize = 14
        message.LineHeight = 1.5
        message.TextColor3 = Color3.fromRGB(157, 157, 165)
        message.TextXAlignment = Enum.TextXAlignment.Left
        message.TextYAlignment = Enum.TextYAlignment.Top
        message.TextWrapped = true
        message.Text = messageText
        message.Parent = content

        local actions = Instance.new("Frame")
        actions.Name = "Actions"
        actions.LayoutOrder = 4
        actions.Size = UDim2.new(1, 0, 0, 40)
        actions.BackgroundTransparency = 1
        actions.Parent = card
        local actionLayout = Instance.new("UIListLayout")
        actionLayout.FillDirection = Enum.FillDirection.Horizontal
        actionLayout.SortOrder = Enum.SortOrder.LayoutOrder
        actionLayout.Padding = UDim.new(0, 8)
        actionLayout.Parent = actions

        local close = Instance.new("TextButton")
        close.Name = "Close"
        close.LayoutOrder = 1
        close.Size = UDim2.new(0.5, -4, 0, 38)
        close.BackgroundColor3 = theme.Background
        close.BorderSizePixel = 0
        close.AutoButtonColor = false
        close.Modal = true
        close.FontFace = mediumFont
        close.TextSize = 13
        close.TextColor3 = theme.Text
        close.Text = "Close"
        close.Parent = actions
        local closeStroke = Instance.new("UIStroke")
        closeStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        closeStroke.Color = theme.Outline
        closeStroke.Thickness = 1
        closeStroke.Parent = close

        local copy = Instance.new("TextButton")
        copy.Name = "CopyDiscordInvite"
        copy.LayoutOrder = 2
        copy.Size = UDim2.new(0.5, -4, 0, 38)
        copy.BackgroundColor3 = theme.Accent
        copy.BorderSizePixel = 0
        copy.AutoButtonColor = false
        copy.FontFace = mediumFont
        copy.TextSize = 13
        copy.TextColor3 = Color3.fromRGB(24, 24, 27)
        copy.Text = "Copy invite"
        copy.Parent = actions

        local closing = false
        local opening = true
        local dragInput, dragStart, dragOrigin, dragTarget, dragPosition
        local moved = false
        local inputConnections = {}
        local fades = {
            { card, "BackgroundTransparency" },
            { stroke, "Transparency" },
            { content, "ScrollBarImageTransparency" },
            { title, "TextTransparency" },
            { message, "TextTransparency" },
            { close, "BackgroundTransparency" },
            { closeStroke, "Transparency" },
            { close, "TextTransparency" },
            { copy, "BackgroundTransparency" },
            { copy, "TextTransparency" },
        }
        local function fadeContent(alpha, duration)
            local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            for _, item in ipairs(fades) do
                TweenService:Create(item[1], info, { [item[2]] = alpha }):Play()
            end
        end
        local function centeredPosition()
            return UDim2.fromOffset(
                math.floor((backdrop.AbsoluteSize.X - card.AbsoluteSize.X) / 2),
                math.floor((backdrop.AbsoluteSize.Y - card.AbsoluteSize.Y) / 2)
            )
        end
        local function clampPosition(position)
            return Vector2.new(
                math.clamp(position.X, 12, math.max(12, backdrop.AbsoluteSize.X - card.AbsoluteSize.X - 12)),
                math.clamp(position.Y, 12, math.max(12, backdrop.AbsoluteSize.Y - card.AbsoluteSize.Y - 12))
            )
        end
        local layoutQueued, layoutBusy, layoutAgain = false, false, false
        local measuredWidth, measuredText, measuredHeight
        local requestLayout
        local function applyLayout()
            if closing or not screen.Parent then return end
            if layoutBusy then layoutAgain = true return end
            layoutBusy = true
            local viewport = backdrop.AbsoluteSize
            local short = viewport.Y < 360
            local compact = viewport.X < 600 or short
            local margin = compact and 12 or 20
            local inset = short and 16 or (viewport.X <= 360 and 18 or 20)
            local width = math.max(1, math.min(380, viewport.X - margin * 2))
            local innerWidth = math.max(1, width - inset * 2)
            local titleHeight = math.ceil(title.AbsoluteSize.Y)
            local headingGap = 10
            local actionGap = 16
            local stacked = width < 260 and viewport.Y >= 400
            local buttonHeight = (UserInputService.TouchEnabled or viewport.X < 420) and 44 or 38
            local actionHeight = stacked and buttonHeight * 2 + 8 or buttonHeight

            title.Position = UDim2.fromOffset(inset, inset)
            content.Position = UDim2.fromOffset(inset, inset + titleHeight + headingGap)
            content.Size = UDim2.fromOffset(innerWidth, content.Size.Y.Offset)
            title.Size = UDim2.fromOffset(innerWidth, 0)
            local messageWidth = math.max(1, innerWidth - 6)
            if measuredWidth ~= messageWidth or measuredText ~= message.Text then
                local measuredValue = message.Text
                local params = Instance.new("GetTextBoundsParams")
                params.Font = message.FontFace
                params.Size = message.TextSize
                params.Text = measuredValue
                params.Width = messageWidth
                local bounds = TextService:GetTextBoundsAsync(params)
                params:Destroy()
                if closing or not screen.Parent then layoutBusy = false return end
                measuredWidth, measuredText = messageWidth, measuredValue
                measuredHeight = math.ceil(bounds.Y * message.LineHeight) + 2
            end
            message.Size = UDim2.fromOffset(messageWidth, measuredHeight)
            actionLayout.FillDirection = stacked and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
            close.LayoutOrder = stacked and 2 or 1
            copy.LayoutOrder = stacked and 1 or 2
            close.Size = stacked and UDim2.new(1, 0, 0, buttonHeight) or UDim2.new(0.5, -4, 0, buttonHeight)
            copy.Size = stacked and UDim2.new(1, 0, 0, buttonHeight) or UDim2.new(0.5, -4, 0, buttonHeight)

            local fixedHeight = inset * 2 + titleHeight + headingGap + actionGap + actionHeight
            local availableHeight = math.max(1, viewport.Y - margin * 2 - fixedHeight)
            local naturalHeight = measuredHeight
            local bodyHeight = math.min(naturalHeight, availableHeight)
            content.Size = UDim2.fromOffset(innerWidth, bodyHeight)
            content.ScrollingEnabled = naturalHeight > bodyHeight
            content.ScrollBarThickness = content.ScrollingEnabled and 3 or 0
            actions.Position = UDim2.fromOffset(inset, content.Position.Y.Offset + bodyHeight + actionGap)
            actions.Size = UDim2.fromOffset(innerWidth, actionHeight)
            card.Size = UDim2.fromOffset(width, fixedHeight + bodyHeight)
            layoutBusy = false
            if layoutAgain then
                layoutAgain = false
                requestLayout()
            end
        end
        requestLayout = function()
            if layoutQueued or closing then return end
            layoutQueued = true
            task.defer(function()
                layoutQueued = false
                applyLayout()
            end)
        end
        title:GetPropertyChangedSignal("AbsoluteSize"):Connect(requestLayout)
        message:GetPropertyChangedSignal("Text"):Connect(requestLayout)
        backdrop:GetPropertyChangedSignal("AbsoluteSize"):Connect(requestLayout)

        local function beginDrag(input)
            if closing or opening or dragInput then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            dragInput = input
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            dragOrigin = Vector2.new(card.Position.X.Offset, card.Position.Y.Offset)
            dragPosition, dragTarget = dragOrigin, dragOrigin
            moved = true
        end
        local function moveDrag(input)
            if not dragInput or closing then return end
            if input ~= dragInput and not (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then return end
            dragTarget = clampPosition(dragOrigin + Vector2.new(input.Position.X, input.Position.Y) - dragStart)
        end
        local function endDrag(input)
            if input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
                dragInput = nil
            end
        end
        title.InputBegan:Connect(beginDrag)
        inputConnections[1] = UserInputService.InputChanged:Connect(moveDrag)
        inputConnections[2] = UserInputService.InputEnded:Connect(endDrag)

        for button, colors in pairs({
            [close] = { theme.Background, theme.Background:Lerp(theme.Text, 0.07) },
            [copy] = { theme.Accent, Color3.fromRGB(255, 255, 255) },
        }) do
            local buttonCorner = Instance.new("UICorner")
            buttonCorner.CornerRadius = UDim.new(0, 6)
            buttonCorner.Parent = button
            local hovered = false
            local function tint(color, duration)
                if closing then return end
                TweenService:Create(button, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                    BackgroundColor3 = color,
                }):Play()
            end
            button.MouseEnter:Connect(function()
                hovered = true
                tint(colors[2], 0.16)
            end)
            button.MouseLeave:Connect(function()
                hovered = false
                tint(colors[1], 0.16)
            end)
            button.MouseButton1Down:Connect(function()
                tint(colors[1]:Lerp(theme.Main, 0.15), 0.08)
            end)
            button.MouseButton1Up:Connect(function()
                tint(hovered and colors[2] or colors[1], 0.12)
            end)
        end

        copy.Activated:Connect(function()
            if closing then return end
            local copied = pcall(setclipboard, inviteURL)
            copy.Text = copied and "Link copied" or "Couldn't copy"
            if not copied then
                message.Text = "Discord: " .. inviteURL
            end
        end)
        close.Activated:Connect(function()
            if closing then return end
            closing = true
            dragInput = nil
            fadeContent(1, 0.16)
            local exit = TweenService:Create(card, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = card.Position + UDim2.fromOffset(0, 6),
            })
            TweenService:Create(backdrop, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
            exit.Completed:Once(function() screen:Destroy() end)
            exit:Play()
        end)

        local previousMouseBehavior = UserInputService.MouseBehavior
        local previousMouseIconEnabled = UserInputService.MouseIconEnabled
        local mouseBinding = "KoraxUpdateNoticeMouse"
        local mouseRestored = false
        local function restoreMouse()
            if mouseRestored then return end
            mouseRestored = true
            for _, connection in ipairs(inputConnections) do connection:Disconnect() end
            RunService:UnbindFromRenderStep(mouseBinding)
            UserInputService.MouseBehavior = previousMouseBehavior
            UserInputService.MouseIconEnabled = previousMouseIconEnabled
            if env.__KoraxUpdateNoticeCleanup == restoreMouse then
                env.__KoraxUpdateNoticeCleanup = nil
            end
        end
        env.__KoraxUpdateNoticeCleanup = restoreMouse
        screen.Destroying:Connect(restoreMouse)

        screen.Parent = parent
        applyLayout()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        applyLayout()
        local targetPosition = centeredPosition()
        card.Position = targetPosition + UDim2.fromOffset(0, 12)
        for _, item in ipairs(fades) do item[1][item[2]] = 1 end
        card.Visible = true
        local function updateNotice(deltaTime)
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            if dragTarget and not closing then
                dragPosition = dragPosition:Lerp(dragTarget, 1 - math.exp(-32 * deltaTime))
                if (dragPosition - dragTarget).Magnitude < 0.25 then
                    dragPosition = dragTarget
                    if not dragInput then dragTarget = nil end
                end
                card.Position = UDim2.fromOffset(math.round(dragPosition.X), math.round(dragPosition.Y))
            end
        end
        RunService:BindToRenderStep(mouseBinding, Enum.RenderPriority.Last.Value + 1, updateNotice)
        updateNotice(0)
        fadeContent(0, 0.22)
        TweenService:Create(backdrop, TweenInfo.new(0.28), { BackgroundTransparency = 0.55 }):Play()
        local entrance = TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = targetPosition,
        })
        entrance.Completed:Once(function()
            if closing or not screen.Parent then return end
            opening = false
            local function recenter()
                if closing then return end
                if moved then
                    dragPosition = clampPosition(Vector2.new(card.Position.X.Offset, card.Position.Y.Offset))
                    dragTarget = nil
                    card.Position = UDim2.fromOffset(math.round(dragPosition.X), math.round(dragPosition.Y))
                else
                    card.Position = centeredPosition()
                end
            end
            recenter()
            card:GetPropertyChangedSignal("AbsoluteSize"):Connect(recenter)
            backdrop:GetPropertyChangedSignal("AbsoluteSize"):Connect(recenter)
        end)
        entrance:Play()

    end

    showStartupNotice(
        "Updating",
        "Korax is being updated.\nCheck Discord for the latest news."
    )
    openDiscordInvite()
end
