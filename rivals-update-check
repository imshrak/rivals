    if not ok then return nil end
    return consts[index]
end

function NativeRemovals.EnsureScopeHook()
    local scope = NativeRemovals.Scope
    if scope.Restore ~= nil or not (scope.OverlayHidden or scope.ReticleHidden) then return end
    local scopeClass = NativeRemovals.RequireModule('Scope')
    local setActive = scopeClass and rawget(scopeClass, 'SetActive') or nil
    if type(setActive) ~= 'function' then return end
    local wrapped = function(self, active)
        coroutine.wrap(setActive)(self, active)
        if not rawget(self, '_is_scope_active') then return end
        if scope.OverlayDirty then
            local visible = not scope.OverlayHidden
            local circleFrame = rawget(self, 'CircleFrame')
            local blurFrame = rawget(self, 'BlurFrame')
            if circleFrame then circleFrame.Visible = visible end
            if blurFrame then blurFrame.Visible = visible end
        end
        if scope.ReticleDirty then
            local reticleContainer = rawget(self, 'ReticleContainer')
            if reticleContainer then reticleContainer.Visible = not scope.ReticleHidden end
        end
    end
    rawset(scopeClass, 'SetActive', wrapped)
    scope.Restore = { class = scopeClass, original = setActive }
end

function NativeRemovals.RevertScopeHook()
    local scope = NativeRemovals.Scope
    local restore = scope.Restore
    if not restore then return end
    scope.Restore = nil
    rawset(restore.class, 'SetActive', restore.original)
end

