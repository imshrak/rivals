local function rageEncodeSingle(n)
    if n == n then
        return utf8.char(math.clamp(math.floor(n % (2 * math.pi) / math.pi / 2 * 256 + 0.5), 0, 255))
    end
    return utf8.char(0)
end
local function rageEncodeCam(v)
    if v == v then
        return rageEncodeSingle(v.X) .. rageEncodeSingle(v.Y)
    end
    return utf8.char(0) .. utf8.char(0)
end
local function rageDecodeSingle(s)
    return utf8.codepoint(s) * math.pi * 2 / 256
end

local function RagebotDesyncRenderStep()
