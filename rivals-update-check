local BodyParts = {
    "Head",
    "HumanoidRootPart",
    "LeftUpperArm",
    "RightUpperArm",
    "LeftUpperLeg",
    "RightUpperLeg"
}

local function getFighters()
    if _G.EnemyRegistry then return _G.EnemyRegistry end
    if _G.Fighters then return _G.Fighters end
    if _G.fighters then return _G.fighters end
    return nil
end

local function getTeamId(player)
    local teamId = player:GetAttribute("TeamID")
    if teamId then return teamId end
    if player.Team then return player.Team.Name end
    return nil
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not getgenv().Config.TeamCheck then return true end
    local fighters = getFighters()
    local localTeamId = getTeamId(LocalPlayer)
    if fighters and fighters.byPlayer then
        local fighter = fighters.byPlayer[player]
        if fighter then
            return fighter.isEnemy == true
        end
    end
    if fighters and fighters.enemies then
        for enemyPlayer, _ in pairs(fighters.enemies) do
            if enemyPlayer == player then
                return true
            end
        end
    end
    local playerTeamId = getTeamId(player)
    if playerTeamId and localTeamId then
        return playerTeamId ~= localTeamId
    end
    local char = player.Character
    if char then
        if char:FindFirstChild("Enemy") or char:GetAttribute("IsEnemy") then
            return true
        end
    end
    return true
end

local function isAlive(character)
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    return true
end

local function getHitPart(character)
    if not isAlive(character) then return nil end
    local selectedPart = getgenv().Config.HitPart
    if selectedPart == "Random" then
        local randomPart = BodyParts[math.random(1, #BodyParts)]
        return character:FindFirstChild(randomPart)
    elseif selectedPart == "Body" then
        return character:FindFirstChild("HumanoidRootPart")
    else
        return character:FindFirstChild(selectedPart)
    end
end

local visibilityRaycastParams = RaycastParams.new()
visibilityRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist
visibilityRaycastParams.IgnoreWater = true
local lastFilterCharacter = nil

local function isTargetVisible(origin, targetPart)
    if not targetPart or not targetPart:IsA("BasePart") then
        return false
    end
    if lastFilterCharacter ~= LocalPlayer.Character then
        lastFilterCharacter = LocalPlayer.Character
        visibilityRaycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end
    local targetPosition = targetPart.Position
    local direction = (targetPosition - origin)
    local distance = direction.Magnitude
    direction = direction.Unit
    local result = workspace:Raycast(origin, direction * distance, visibilityRaycastParams)
    if not result then
        return true
    end
    local hitInstance = result.Instance
    local targetCharacter = targetPart:IsDescendantOf(workspace) and targetPart.Parent
    while targetCharacter and not targetCharacter:IsA("Model") do
        targetCharacter = targetCharacter.Parent
    end
    if targetCharacter and targetCharacter:IsA("Model") then
        if hitInstance:IsDescendantOf(targetCharacter) then
            return true
        end
    end
    return false
end

local function updatePlayerESP(player)
    local character = player.Character
    local label = playerDistanceLabels[player]
    local highlight = playerHighlights[player]
    if not character or not character:IsDescendantOf(workspace) or not LocalPlayer.Character then
        if label then label.Visible = false end
        if highlight then pcall(function() highlight.Enabled = false end) end
        return
    end
    if not isEnemy(player) then
        if label then label.Visible = false end
        if highlight then pcall(function() highlight.Enabled = false end) end
        return
    end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not humanoid or humanoid.Health <= 0 or not localRoot then
        if label then label.Visible = false end
        if highlight then pcall(function() highlight.Enabled = false end) end
        return
    end
    local distance = (rootPart.Position - localRoot.Position).Magnitude
    if highlight then
        pcall(function()
            highlight.Adornee = character
            local cam = workspace.CurrentCamera
            local vis = cam and ESPIsVisible(character, cam) or false
            local col = getgenv().Config[vis and "ESPVisibleColor" or "ESPHiddenColor"]
            local ok, c = pcall(Color3.fromRGB, col and col[1], col and col[2], col and col[3])
            local color = ok and c or Color3.new(1, 0, 0)
            highlight.FillColor = color
            highlight.OutlineColor = color
            highlight.Enabled = distance <= MAX_DISTANCE and getgenv().Config.ESPEnabled and getgenv().Config.HighlightEnabled
        end)
    end
    if label and getgenv().Config.DistanceEnabled and distance <= MAX_DISTANCE and head then
        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        if onScreen then
            label.Position = Vector2.new(headPos.X, headPos.Y)
            label.Text = math.floor(distance) .. " studs"
            label.Visible = true
        else
            label.Visible = false
        end
    elseif label then
        label.Visible = false
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    local distanceLabel = Drawing.new("Text")
    distanceLabel.Color = PURPLE
    distanceLabel.Size = 14
    distanceLabel.Center = true
    distanceLabel.Outline = true
    distanceLabel.OutlineColor = Color3.fromRGB(0, 0, 0)
    distanceLabel.Visible = false
    playerDistanceLabels[player] = distanceLabel
    local highlight = Instance.new("Highlight")
    highlight.FillColor = PURPLE
    highlight.OutlineColor = PURPLE
    highlight.FillTransparency = 0.8
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = game:GetService("CoreGui")
    playerHighlights[player] = highlight
    if player.Character then
        pcall(function() highlight.Adornee = player.Character end)
    end
    local connection = RunService.RenderStepped:Connect(function()
        if not player:IsDescendantOf(Players) then
            connection:Disconnect()
            distanceLabel:Remove()
            pcall(function() highlight:Destroy() end)
            playerDistanceLabels[player] = nil
            playerHighlights[player] = nil
            playerConnections[player] = nil
            return
        end
        updatePlayerESP(player)
    end)
    playerConnections[player] = connection
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    setupPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
    local connection = playerConnections[player]
    if connection then
        connection:Disconnect()
        playerConnections[player] = nil
    end
    local highlight = playerHighlights[player]
    if highlight then
        pcall(function() highlight:Destroy() end)
        playerHighlights[player] = nil
    end
    local label = playerDistanceLabels[player]
    if label then
        label:Remove()
        playerDistanceLabels[player] = nil
    end
end)

