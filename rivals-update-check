local function rageInstallReplicationSpoof(fighterCtrl)
    if not fighterCtrl then return end
    local proto = getmetatable(fighterCtrl)
    if type(proto) ~= 'table' then proto = nil end
    proto = proto and rawget(proto, '__index') or nil
    local loop = proto and rawget(proto, '_CameraReplicationLoop') or nil
    if not loop then return end
    local ok, ups = pcall(debug.getupvalues, loop)
    if not ok or type(ups) ~= 'table' then return end
    for i, val in pairs(ups) do
        if type(val) == 'table' then
            local vmt = getmetatable(val)
            local vidx = vmt and rawget(vmt, '__index') or nil
            if vidx and rawget(vidx, 'EncodeCameraRotation') ~= nil then
                local replacement = {}
                function replacement.EncodeCameraRotation(_, raw)
                    if RagebotEnabled and RageDesyncPending ~= nil then
                        if RageCamRawLock == nil then
                            RageCamRawLock = rageEncodeCam(raw)
                        end
                        return RageCamRawLock
                    end
                    RageCamRawLock = rageEncodeCam(raw)
                    return RageCamRawLock
                end
                if pcall(debug.setupvalue, loop, i, replacement) then
                    RageCamHooks = { replication = { loop = loop, index = i, original = val } }
                end
                return
            end
        end
    end
end

local function rageInstallJointsSpoof()
    local modules = ReplicatedStorage:FindFirstChild('Modules')
    local mod = modules and modules:FindFirstChild('ClientFighterCharacterJoints') or nil
    if not mod then return end
    local ok, joints = pcall(require, mod)
    if not ok or type(joints) ~= 'table' then return end
    local original = rawget(joints, 'Update')
    if not original then return end
    rawset(joints, 'Update', function(jointsSelf, a, b)
        if RagebotEnabled and RageDesyncPending ~= nil and RageCamAimRaw then
            pcall(function() b.CameraRotationRaw = RageCamAimRaw end)
        end
        return original(jointsSelf, a, b)
    end)
    RageCamHooks = RageCamHooks or {}
    RageCamHooks.joints = { joints = joints, original = original }
end

local function RagebotIsEnemy(player)
    if player == lp then return false end
    local pTeam = player:GetAttribute("TeamID")
    local lTeam = lp:GetAttribute("TeamID")
    if pTeam and lTeam then
        return pTeam ~= lTeam
    end
    if player.Team and lp.Team then
        return player.Team ~= lp.Team
    end
    local char = player.Character
    if char then
        if char:FindFirstChild("Enemy") or char:GetAttribute("IsEnemy") then
            return true
        end
    end
    return true
end

local function RagebotResolveFighter(player)
    if not player then return nil end
    local cached = RageFighterCache[player]
    if cached and cached.Entity then
        return cached
    end
    if not RageFighterCtrl then return nil end
    local ok, got = pcall(RageFighterCtrl.GetFighter, RageFighterCtrl, player)
    if ok and got then
        RageFighterCache[player] = got
        return got
    end
    RageFighterCache[player] = nil
    return nil
end

local function RagebotIsSpawnShielded(player)
    local fighter = RagebotResolveFighter(player)
    if not fighter then return false end
    local entity = fighter.Entity
    return type(entity) == 'table'
        and type(entity.Data) == 'table'
        and entity.Data.IsInvincible == true
end

local function RagebotGetClosest()
    local char = lp.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil, nil end
    local closestPlayer, closestRoot, closestHead = nil, nil, nil
    local closestDist = 500
    for _, player in ipairs(Players:GetPlayers()) do
        if not RagebotIsEnemy(player) then continue end
        if RagebotIsSpawnShielded(player) then continue end
        local pChar = player.Character
        if not pChar then continue end
        local pRoot = pChar:FindFirstChild("HumanoidRootPart")
        local pHead = pChar:FindFirstChild("Head")
        local pHum = pChar:FindFirstChildWhichIsA("Humanoid")
        if not (pRoot and pHead and pHum and pHum.Health > 0) then continue end
        local dist = (myRoot.Position - pRoot.Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestPlayer = player
            closestRoot = pRoot
            closestHead = pHead
        end
    end
    return closestPlayer, closestRoot, closestHead
end

local function RagebotHasKnifeViewModel(targetPlayer)
    if not targetPlayer then return false end
    local viewModels = workspace:FindFirstChild("ViewModels")
    if not viewModels then return false end
    local targetName = targetPlayer.Name
    for _, model in viewModels:GetChildren() do
        if model:IsA("Model")
           and string.find(model.Name, targetName, 1, true)
           and string.find(model.Name, "Knife", 1, true) then
            return true
        end
    end
    return false
end

local function RagebotIsItemReloading(item)
    if not item then return false end
    local now = tick()
    local reloadCD = rawget(item, '_reload_cooldown')
    if type(reloadCD) == 'number' and now < reloadCD then return true end
    local noAmmoCD = rawget(item, '_shoot_cooldown_no_ammo')
    return type(noAmmoCD) == 'number' and now < noAmmoCD
end
local function RagebotItemHasAmmo(item)
    if not item then return false end
    local data = rawget(item, 'Data')
    local ammo = data and rawget(data, 'Ammo')
    return type(ammo) ~= 'number' or ammo > 0
end

local function RagebotStart()
    if RagebotConnection then return end

    local ok1, rageUtil = pcall(function()
        return require(ReplicatedStorage.Modules.Utility)
    end)
    local ok2, rageEnum = pcall(function()
        return require(ReplicatedStorage.Modules.EnumLibrary)
    end)
    local ok3, rageFighterCtrl = pcall(function()
        return require(lp.PlayerScripts.Controllers.FighterController)
    end)
    if not (ok1 and ok2 and ok3) then return end

    RageFighterCtrl = rageFighterCtrl

    RagebotLastFire = 0
    RagebotDeflecting = {}
    RageCamRawLock = nil
    RageCamAimRaw = nil

    if RageCamHooks == nil then
        rageInstallReplicationSpoof(rageFighterCtrl)
        rageInstallJointsSpoof()
    end

    RagebotConnection = RunService.Heartbeat:Connect(function()
        if not RagebotEnabled then return end

        local targetPlayer, targetRoot, targetHead = RagebotGetClosest()

        local char = lp.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local now = os.clock()

        if not targetPlayer or not targetRoot or not targetHead then return end

        local lf = rageFighterCtrl.LocalFighter
        if not lf then return end
        local item = lf.EquippedItem
        if not item then return end
        if RagebotIsItemReloading(item) then return end
        if not RagebotItemHasAmmo(item) then return end
        if tick() - RagebotLastFire < 0.0005 then return end
        RagebotLastFire = tick()

        if now - RageEvadeTimer >= rageConfig("RageEvadeInterval", 0.3) then
            RageEvadeTimer = now
            RageEvadeAngle = (RageEvadeAngle + math.rad(20 + math.random() * 45)) % (2 * math.pi)
        end

        local desyncPos
        if RagebotHasKnifeViewModel(targetPlayer) then
            desyncPos = (targetRoot.CFrame * CFrame.new(
                math.cos(RageEvadeAngle) * 4,
                rageConfig("RageKnifeLift", 9),
                math.sin(RageEvadeAngle) * 4
            )).Position
        else
            desyncPos = (targetRoot.CFrame * CFrame.new(
                math.cos(RageEvadeAngle) * 5,
                rageConfig("RageLift", 2),
                math.sin(RageEvadeAngle) * 5
            )).Position
        end
        local desyncCF = CFrame.lookAt(desyncPos, targetHead.Position)

        RageDesyncPending = {
            root = myRoot,
            cf = myRoot.CFrame,
            vel = myRoot.Velocity,
            rotvel = myRoot.RotVelocity,
        }
        myRoot.CFrame = desyncCF

        local originPos = desyncCF.Position
        local targetPos = targetHead.Position
        local aimCF = CFrame.lookAt(originPos, targetPos)

        local sx, sy = aimCF:ToOrientation()
        RageCamAimRaw = Vector2.new(
            rageDecodeSingle(rageEncodeSingle(sx)),
            rageDecodeSingle(rageEncodeSingle(sy))
        )

        local targetCF = targetHead.CFrame
        local randomOffset = Vector3.new(
            (math.random() - 0.5) * 0.1,
            (math.random() - 0.5) * 0.1,
            (math.random() - 0.5) * 0.1
        )
        local aimedPos = targetPos + randomOffset
        local objSpaceHeadOffset = targetHead.CFrame:ToObjectSpace(CFrame.new(aimedPos))
        local cameradata = {}
        cameradata[utf8.char(1)] = {
            [utf8.char(0)] = rageUtil:EncodeCFrame(aimCF),
            [utf8.char(1)] = rageUtil:EncodeCFrame(targetCF),
            [utf8.char(2)] = targetHead,
            [utf8.char(3)] = rageUtil:EncodeCFrame(objSpaceHeadOffset)
        }
        ReplicatedStorage.Remotes.Replication.Fighter.UseItem:FireServer(
            item:Get("ObjectID"),
            rageEnum:ToEnum("StartShooting"),
            cameradata,
            nil
        )
    end)
end

local function RagebotStop()
    if RagebotConnection then
        RagebotConnection:Disconnect()
        RagebotConnection = nil
    end

    local pending = RageDesyncPending
    RageDesyncPending = nil
    if pending and pending.root then
        pcall(function()
            pending.root.CFrame = pending.cf
            pending.root.Velocity = pending.vel
            pending.root.RotVelocity = pending.rotvel
        end)
    end

    if RageCamHooks then
        if RageCamHooks.replication then
            pcall(debug.setupvalue, RageCamHooks.replication.loop, RageCamHooks.replication.index, RageCamHooks.replication.original)
        end
        if RageCamHooks.joints then
            pcall(rawset, RageCamHooks.joints.joints, 'Update', RageCamHooks.joints.original)
        end
        RageCamHooks = nil
    end
    RageCamRawLock = nil
    RageCamAimRaw = nil
    RageFighterCtrl = nil
    RageFighterCache = {}
    RageEvadeTimer = 0
    RageEvadeAngle = 0
    RagebotDeflecting = {}
end

