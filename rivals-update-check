local function ThrowablesESPIsTracked(instance)
    return instance ~= nil
        and (instance:IsA("BasePart") or instance:IsA("Model"))
        and ThrowablesESP.TRACKED[instance.Name] ~= nil
end

local function ThrowablesESPCreateLabel(instance)
    if ThrowablesESP.Labels[instance] then return end
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then return end
    local label = Drawing.new("Text")
    label.Center = true
    label.Outline = true
    label.Font = 2
    label.Size = ESP._cfg.ThrowablesTextSize
    label.Transparency = 1
    label.Visible = false
    ThrowablesESP.Labels[instance] = {
        label = label,
        visible = false,
        lastText = nil,
        lastSize = nil,
        lastColor = nil,
        lastX = nil,
        lastY = nil,
        lastDistance = nil,
    }
end

local function ThrowablesESPDestroyLabel(instance)
    local entry = ThrowablesESP.Labels[instance]
    if not entry then return end
    pcall(function() entry.label:Remove() end)
    ThrowablesESP.Labels[instance] = nil
end

local function ThrowablesESPHide(entry)
    if entry.visible then
        entry.label.Visible = false
        entry.visible = false
    end
end

local function ThrowablesESPUpdate()
    local cfg = ESP._cfg
    if not cfg.ThrowablesESPEnabled then
        for _, entry in pairs(ThrowablesESP.Labels) do ThrowablesESPHide(entry) end
        return
    end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local rootX, rootY, rootZ
    if root then
        local pos = root.Position
        rootX, rootY, rootZ = pos.X, pos.Y, pos.Z
    end
    local maxDistSq = cfg.ThrowablesMaxDistance * cfg.ThrowablesMaxDistance
    local textSize = cfg.ThrowablesTextSize
    for instance in pairs(ThrowablesESP.Labels) do
        if not instance.Parent or not instance:IsDescendantOf(workspace) or not ThrowablesESPIsTracked(instance) then
            ThrowablesESPDestroyLabel(instance)
        end
    end
    for instance, entry in pairs(ThrowablesESP.Labels) do
        local info = ThrowablesESP.TRACKED[instance.Name]
        if not info then continue end
        local position = instance:IsA("BasePart") and instance.Position or instance:GetPivot().Position
        local screen, onScreen = camera:WorldToViewportPoint(position)
        if not onScreen or screen.Z <= 0 then
            ThrowablesESPHide(entry)
            continue
        end
        local distance = 0
        if rootX then
            local ox = position.X - rootX
            local oy = position.Y - rootY
            local oz = position.Z - rootZ
            local distSq = ox * ox + oy * oy + oz * oz
            if distSq > maxDistSq then
                ThrowablesESPHide(entry)
                continue
            end
            distance = math.sqrt(distSq)
        end
        if not entry.visible then
            entry.label.Visible = true
            entry.visible = true
        end
        if entry.lastSize ~= textSize then
            entry.lastSize = textSize
            entry.label.Size = textSize
        end
        local metres = math.floor(distance)
        if entry.lastDistance ~= metres or entry.lastText ~= info.Label then
            entry.lastDistance = metres
            entry.lastText = info.Label
            entry.label.Text = info.Label .. " | " .. metres .. "m"
        end
        local x, y = screen.X + 0.5, screen.Y + 0.5
        local ix, iy = x - x % 1, y - y % 1
        if entry.lastX ~= ix or entry.lastY ~= iy then
            entry.lastX, entry.lastY = ix, iy
            entry.label.Position = Vector2.new(ix, iy)
        end
        if entry.lastColor ~= info.Color then
            entry.lastColor = info.Color
            entry.label.Color = info.Color
        end
    end
end

