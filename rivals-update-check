function Movement.ClearNoclipCharacter()
    if Movement.NoclipConnections then
        for _, conn in ipairs(Movement.NoclipConnections) do
            conn:Disconnect()
        end
    end
    Movement.NoclipConnections = nil
    Movement.NoclipCharacter = nil
    table.clear(Movement.CollidableParts)
end

function Movement.DestroyFlight()
    local flight = Movement.Flight
    Movement.Flight = nil
    if flight then
        pcall(function() flight.Velocity:Destroy() end)
        pcall(function() flight.Attachment:Destroy() end)
    end
end

function Movement.ResolveCharacter()
    local character = lp.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if character ~= Movement.Character or humanoid ~= Movement.Humanoid or rootPart ~= Movement.RootPart then
        Movement.ClearNoclipCharacter()
        Movement.DestroyFlight()
        Movement.Character = character
        Movement.Humanoid = humanoid
        Movement.RootPart = rootPart
        Movement.LongJumpPressed = false
    end
    return character, humanoid, rootPart
end

function Movement.ResolveMechanicsController()
    if Movement.MechanicsController then
        return Movement.MechanicsController
    end
    local playerScripts = lp:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local mechanicsModule = controllers and controllers:FindFirstChild("MechanicsController")
    if not mechanicsModule then
        mechanicsModule = playerScripts and playerScripts:FindFirstChild("MechanicsController")
    end
    if mechanicsModule then
        local ok, controller = pcall(require, mechanicsModule)
        Movement.MechanicsController = ok and type(controller) == "table" and controller or nil
    end
    return Movement.MechanicsController
end

function Movement.ResolveControlsMoveVector()
    if Movement.PlayerModule == nil then
        local playerScripts = lp:FindFirstChild("PlayerScripts")
        local moduleScript = playerScripts and playerScripts:FindFirstChild("PlayerModule")
        if moduleScript then
            local ok, playerModule = pcall(require, moduleScript)
            if ok and type(playerModule) == "table"
                and type(playerModule.GetControls) == "function" then
                Movement.PlayerModule = playerModule
            end
        end
    end
    local playerModule = Movement.PlayerModule
    if playerModule then
        local ok, moveVector = pcall(function()
            return playerModule:GetControls():GetMoveVector()
        end)
        if ok and typeof(moveVector) == "Vector3" then
            return moveVector
        end
    end
    return Vector3.zero
end

function Movement.FlattenDirection(vector)
    local flat = Vector3.new(vector.X, 0, vector.Z)
    return flat.Magnitude > 0 and flat.Unit or Vector3.zero
end

function Movement.FlightMoveDirection()
    if UserInputService:GetFocusedTextBox() then
        return Vector3.zero
    end
    local direction = Vector3.zero
    local cframe = workspace.CurrentCamera.CFrame
    if UserInputService.KeyboardEnabled then
        local look = cframe.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        if flatLook.Magnitude > 0 then
            flatLook = flatLook.Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + flatLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - cframe.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - flatLook
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + cframe.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction = direction + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            direction = direction - Vector3.new(0, 1, 0)
        end
    else
        local moveVector = Movement.ResolveControlsMoveVector()
        if moveVector.Magnitude > 0 then
            direction = direction + cframe.LookVector * -moveVector.Z
            direction = direction + cframe.RightVector * moveVector.X
        end
    end
    return direction
end

function Movement.StrafeMoveDirection()
    if UserInputService:GetFocusedTextBox() then
        return Vector3.zero
    end
    local direction = Vector3.zero
    local cframe = workspace.CurrentCamera.CFrame
    local look = Movement.FlattenDirection(cframe.LookVector)
    local right = Movement.FlattenDirection(cframe.RightVector)
    if UserInputService.KeyboardEnabled then
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction = direction + look
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction = direction - look
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction = direction + right
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction = direction - right
        end
    else
        local moveVector = Movement.ResolveControlsMoveVector()
        if moveVector.Magnitude > 0 then
            direction = direction + look * -moveVector.Z
            direction = direction + right * moveVector.X
        end
    end
    if direction.Magnitude > 0 then
        direction = direction.Unit
    end
    return direction
end

function Movement.ReplaceJumpPowerConstants(target)
    local movement = Movement
    for index, value in pairs(debug.getupvalues(target)) do
        if type(value) == "table" then
            local metatable = getmetatable(value)
            local metaIndex = type(metatable) == "table"
                and rawget(metatable, "__index") or nil
            local original = nil
            if type(metaIndex) == "function" then
                local ok, wrapped = pcall(function()
                    return value["meow\0d67"]
                end)
                original = ok and wrapped or nil
            elseif rawget(value, "BASE_JUMPPOWER") ~= nil then
                original = value
            end
            if original ~= nil then
                local upvalueIndex = index
                debug.setupvalue(target, upvalueIndex, setmetatable({}, {
                    __index = function(_, key)
                        if key == "meow\0d67" then
                            return original
                        end
                        if movement.JumpPowerHookDestroyed then
                            debug.setupvalue(target, upvalueIndex, original)
                            return rawget(original, key)
                        end
                        if key ~= "BASE_JUMPPOWER" then
                            return rawget(original, key)
                        end
                        return rawget(original, "BASE_JUMPPOWER")
                            * (movement.JumpPowerEnabled and movement.JumpPowerMultiplier or 1)
                    end,
                }))
                break
            end
        end
    end
end

function Movement.AttemptLoadJumpPowerHook()
    if Movement.JumpPowerHookLoaded then
        return true
    end
    if type(debug.getupvalues) ~= "function" or type(debug.setupvalue) ~= "function"
        or type(debug.getconstants) ~= "function" or type(debug.getprotos) ~= "function"
        or type(debug.getproto) ~= "function" then
        return false
    end
    local mechanics = Movement.ResolveMechanicsController()
    if type(mechanics) ~= "table" then
        return false
    end
    local metatable = getmetatable(mechanics)
    local classIndex = type(metatable) == "table" and rawget(metatable, "__index") or nil
    local hookFighter = type(classIndex) == "table" and rawget(classIndex, "_HookFighter") or nil
    if type(hookFighter) ~= "function" then
        return false
    end
    local localFighter = rawget(mechanics, "LocalFighter")
    if localFighter == nil then
        return false
    end
    Movement.ReplaceJumpPowerConstants(hookFighter)
    local entityAdded = rawget(localFighter, "EntityAdded")
    local handler = type(entityAdded) == "table" and rawget(entityAdded, "_handlerListHead") or nil
    local entityCallback = nil
    while type(handler) == "table" and entityCallback == nil do
        local fn = rawget(handler, "_fn")
        if type(fn) == "function" then
            for _, constant in pairs(debug.getconstants(fn)) do
                if constant == "CustomGravity" then
                    entityCallback = fn
                    break
                end
            end
        end
        handler = rawget(handler, "_next")
    end
    if entityCallback ~= nil then
        Movement.ReplaceJumpPowerConstants(entityCallback)
        for protoIndex in pairs(debug.getprotos(entityCallback)) do
            local activated = debug.getproto(entityCallback, protoIndex, true)
            local instance = type(activated) == "table" and activated[1] or nil
            if instance ~= nil then
                Movement.ReplaceJumpPowerConstants(instance)
            end
        end
    end
    Movement.JumpPowerHookDestroyed = false
    Movement.JumpPowerHookLoaded = true
    return true
end

function Movement.AttemptLoadWalkSpeedHook()
    if Movement.WalkSpeedHookLoaded then
        return true
    end
    if type(debug.getupvalues) ~= "function" or type(debug.setupvalue) ~= "function" then
        return false
    end
    local mechanics = Movement.ResolveMechanicsController()
    if type(mechanics) ~= "table" then
        return false
    end
    local metatable = getmetatable(mechanics)
    local classIndex = type(metatable) == "table" and rawget(metatable, "__index") or nil
    local getWalkSpeed = type(classIndex) == "table" and rawget(classIndex, "_GetWalkSpeed") or nil
    if type(getWalkSpeed) ~= "function" then
        return false
    end
    local upvalueIndex, oldUpvalue
    for index, value in pairs(debug.getupvalues(getWalkSpeed)) do
        if type(value) == "table" and rawget(value, "BASE_WALKSPEED") ~= nil then
            upvalueIndex = index
            oldUpvalue = value
            break
        end
    end
    if upvalueIndex == nil then
        return false
    end
    Movement.WalkSpeedHookGetter = getWalkSpeed
    Movement.WalkSpeedHookUpvalueIndex = upvalueIndex
    Movement.WalkSpeedHookOldUpvalue = oldUpvalue
    debug.setupvalue(getWalkSpeed, upvalueIndex, setmetatable({}, {
        __index = function(_, key)
            if key ~= "BASE_WALKSPEED" then
                lp:Kick("Unexpected behavior (client physics 1)")
                return nil
            end
            local baseWalkSpeed = rawget(oldUpvalue, "BASE_WALKSPEED")
            if Movement.SlidingMultiplierEnabled and debug.info(3, "n") == "Slide" then
                return baseWalkSpeed * Movement.SlidingMultiplier
            end
            if Movement.WalkMultiplierEnabled then
                return baseWalkSpeed * Movement.WalkMultiplier
            end
            return baseWalkSpeed
        end,
    }))
    Movement.WalkSpeedHookLoaded = true
    return true
end

function Movement.UpdateFlight(active)
    local rootPart = Movement.RootPart
    if not active or not rootPart or rootPart.Parent == nil
        or not Movement.Humanoid or Movement.Humanoid.Health <= 0 then
        Movement.DestroyFlight()
        return
    end
    local direction = Movement.FlightMoveDirection()
    if direction.Magnitude > 0 then
        direction = direction.Unit
    end
    local speed = getgenv().Config.FlightSpeed or 100
    local velocityVector = direction * speed
    local flight = Movement.Flight
    if flight and flight.RootPart ~= rootPart then
        Movement.DestroyFlight()
        flight = nil
    end
    if flight then
        flight.Velocity.VectorVelocity = velocityVector
        return
    end
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart
    local velocity = Instance.new("LinearVelocity")
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.MaxForce = math.huge
    velocity.VectorVelocity = velocityVector
    velocity.Attachment0 = attachment
    velocity.Parent = rootPart
    Movement.Flight = { RootPart = rootPart, Attachment = attachment, Velocity = velocity }
end

function Movement.BlankFlightVelocity()
    if Movement.Flight and Movement.RootPart and Movement.RootPart.Parent then
        Movement.RootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

function Movement.BindNoclipCharacter(character)
    Movement.ClearNoclipCharacter()
    Movement.NoclipCharacter = character
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.CanCollide then
            Movement.CollidableParts[descendant] = true
        end
    end
    Movement.NoclipConnections = {
        character.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") and descendant.CanCollide then
                Movement.CollidableParts[descendant] = true
            end
        end),
        character.DescendantRemoving:Connect(function(descendant)
            if descendant:IsA("BasePart") then
                Movement.CollidableParts[descendant] = nil
            end
        end),
    }
end

function Movement.SetNoclipEnabled(enabled)
    if Movement.NoclipEnabled and not enabled then
        for part in pairs(Movement.CollidableParts) do
            part.CanCollide = true
        end
    end
    Movement.NoclipEnabled = enabled == true
end

function Movement.UpdateNoclip(active)
    local character = Movement.Character
    local alive = character ~= nil and Movement.Humanoid ~= nil and Movement.Humanoid.Health > 0
    if not alive then
        Movement.ClearNoclipCharacter()
    elseif Movement.NoclipCharacter ~= character then
        Movement.BindNoclipCharacter(character)
    end
    Movement.SetNoclipEnabled(active == true and alive)
    if not Movement.NoclipEnabled then
        return
    end
    for part in pairs(Movement.CollidableParts) do
        part.CanCollide = false
    end
end

function Movement.UpdateAutoStrafe(deltaTime, active)
    local rootPart = Movement.RootPart
    if not active or not rootPart or not Movement.Humanoid or Movement.Humanoid.Health <= 0
        or not UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        return
    end
    local speed = getgenv().Config.AutoStrafeSpeed or 50
    rootPart.CFrame = rootPart.CFrame + Movement.StrafeMoveDirection() * (speed / 100) * deltaTime * 60
    rootPart.AssemblyLinearVelocity = rootPart.AssemblyLinearVelocity * Vector3.new(0, 1, 0)
end

function Movement.UpdateWalkSpeed(active)
    Movement.WalkMultiplier = getgenv().Config.WalkSpeedMultiplier or 2
    Movement.WalkMultiplierEnabled = active == true
    Movement.AttemptLoadWalkSpeedHook()
end

function Movement.UpdateSliding(active)
    Movement.SlidingMultiplier = getgenv().Config.SlidingMultiplier or 10
    Movement.SlidingMultiplierEnabled = active == true
    Movement.AttemptLoadWalkSpeedHook()
end

function Movement.UpdateJumpPower(active)
    Movement.JumpPowerMultiplier = getgenv().Config.JumpPowerMultiplier or 2
    Movement.JumpPowerEnabled = active == true
    Movement.AttemptLoadJumpPowerHook()
end

function Movement.LaunchLongJump()
    local fighter = VisualModules.FighterController and VisualModules.FighterController:GetFighter(lp)
    local entity = type(fighter) == "table" and rawget(fighter, "Entity") or nil
    if not entity and fighter and type(fighter.GetEntity) == "function" then
        local ok, value = pcall(fighter.GetEntity, fighter)
        entity = ok and value or nil
    end
    local rootPart = Movement.RootPart
    local camera = workspace.CurrentCamera
    if type(entity) ~= "table" or not rootPart or not camera or not Movement.Humanoid
        or Movement.Humanoid.Health <= 0 then
        return false
    end
    local lookVector = camera.CFrame.LookVector
    local direction = Vector3.new(lookVector.X, 0, lookVector.Z)
    if direction.Magnitude < 0.001 then
        local rootLook = rootPart.CFrame.LookVector
        direction = Vector3.new(rootLook.X, 0, rootLook.Z)
    end
    direction = direction.Unit
    local mode = getgenv().Config.LongJumpMode or "Under Feet"
    if mode == "Under Feet" then
        local offset = getgenv().Config.LongJumpOffset or 8
        direction = (direction * offset + Vector3.new(0, 4, 0)).Unit
    end
    local force = getgenv().Config.LongJumpForce or 60
    local upVelocity = getgenv().Config.LongJumpUpVelocity or 20
    local velocity = direction * force + Vector3.new(0, upVelocity, 0)
    if type(entity.AirborneCancel) ~= "function" or type(entity.AirborneTrigger) ~= "function" then
        return false
    end
    pcall(entity.AirborneCancel, entity)
    local ok = pcall(entity.AirborneTrigger, entity, velocity, 4)
    return ok
end

function Movement.UpdateLongJump(active)
    if active and not Movement.LongJumpPressed then
        Movement.LaunchLongJump()
    end
    Movement.LongJumpPressed = active
end

function Movement.StoreOriginalItemInfo(item)
    if type(item) ~= "table" or Movement.OriginalItemInfo[item] ~= nil then return end
    local info = item.Info
    if type(info) ~= "table" then return end
    Movement.OriginalItemInfo[item] = {
        Info = info,
        HasMaxDoubleJumps = rawget(info, "MaxDoubleJumps") ~= nil,
        MaxDoubleJumps = rawget(info, "MaxDoubleJumps"),
    }
end

function Movement.ApplyItemModifiers(item)
    Movement.StoreOriginalItemInfo(item)
    local original = Movement.OriginalItemInfo[item]
    local info = original and original.Info or nil
    if type(info) ~= "table" then return end
    if getgenv().Config.InfDoubleJumps then
        rawset(info, "MaxDoubleJumps", 676767)
    elseif original.HasMaxDoubleJumps then
        rawset(info, "MaxDoubleJumps", original.MaxDoubleJumps)
    else
        rawset(info, "MaxDoubleJumps", nil)
    end
end

function Movement.RestoreItemModifiers(item)
    local original = Movement.OriginalItemInfo[item]
    local info = original and original.Info or nil
    if type(info) ~= "table" then return end
    if original.HasMaxDoubleJumps then
        rawset(info, "MaxDoubleJumps", original.MaxDoubleJumps)
    else
        rawset(info, "MaxDoubleJumps", nil)
    end
    Movement.OriginalItemInfo[item] = nil
end

function Movement.RestoreAllItemModifiers()
    for item in pairs(Movement.OriginalItemInfo) do
        Movement.RestoreItemModifiers(item)
    end
    Movement.OriginalItemInfo = {}
end

function Movement.DisconnectItemSignals()
    if Movement.InfoModifierItemAdded then
        Movement.InfoModifierItemAdded:Disconnect()
        Movement.InfoModifierItemAdded = nil
    end
    if Movement.InfoModifierItemRemoved then
        Movement.InfoModifierItemRemoved:Disconnect()
        Movement.InfoModifierItemRemoved = nil
    end
    Movement.InfoModifierFighter = nil
end

function Movement.ResolveLocalFighter()
    if Movement._cachedFighterController == nil then
        Movement._cachedFighterController = false
        pcall(function()
            local ps = lp:WaitForChild("PlayerScripts")
            local ctrl = ps:WaitForChild("Controllers"):FindFirstChild("FighterController")
            if ctrl then
                local ok, mod = pcall(require, ctrl)
                if ok and type(mod) == "table" then
                    Movement._cachedFighterController = mod
                end
            end
        end)
    end
    local fc = Movement._cachedFighterController
    if not fc then return nil end
    if fc.LocalFighter then return fc.LocalFighter end
    if type(fc.GetFighter) ~= "function" then return nil end
    local ok, fighter = pcall(fc.GetFighter, fc, lp)
    if ok and fighter then return fighter end
    if lp.Character then
        ok, fighter = pcall(fc.GetFighter, fc, lp.Character)
        if ok and fighter then return fighter end
    end
    return nil
end

function Movement.RefreshInfDoubleJumps()
    local fighter = Movement.ResolveLocalFighter()
    if fighter ~= Movement.InfoModifierFighter then
        Movement.RestoreAllItemModifiers()
        Movement.DisconnectItemSignals()
        Movement.InfoModifierFighter = fighter
        if fighter then
            if fighter.ItemAdded and type(fighter.ItemAdded.Connect) == "function" then
                Movement.InfoModifierItemAdded = fighter.ItemAdded:Connect(function(item)
                    Movement.ApplyItemModifiers(item)
                end)
            end
            if fighter.ItemRemoved and type(fighter.ItemRemoved.Connect) == "function" then
                Movement.InfoModifierItemRemoved = fighter.ItemRemoved:Connect(function(item)
                    Movement.RestoreItemModifiers(item)
                end)
            end
        end
    end
    if not fighter or type(fighter.Items) ~= "table" then return end
    for _, item in pairs(fighter.Items) do
        Movement.ApplyItemModifiers(item)
    end
end

function Movement.UpdateInfDoubleJumps()
    if getgenv().Config.InfDoubleJumps then
        Movement.RefreshInfDoubleJumps()
    else
        Movement.RestoreAllItemModifiers()
        Movement.DisconnectItemSignals()
    end
end

function Movement.Update(deltaTime)
    Movement.ResolveCharacter()
    Movement.UpdateWalkSpeed(getgenv().Config.WalkSpeed)
    Movement.UpdateSliding(getgenv().Config.SlidingSpeed)
    Movement.UpdateJumpPower(getgenv().Config.JumpPower)
    Movement.UpdateAutoStrafe(deltaTime, getgenv().Config.AutoStrafe)
    Movement.UpdateFlight(getgenv().Config.Flight)
    Movement.UpdateNoclip(getgenv().Config.Noclip)
    Movement.UpdateLongJump(getgenv().Config.LongJump)
    Movement.UpdateInfDoubleJumps()
end

