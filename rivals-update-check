local function ESPGetSkeletonParts(character)
    local skP = ESP._skParts
    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local root = character:FindFirstChild("HumanoidRootPart")
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand") or character:FindFirstChild("LeftUpperArm")
    local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand") or character:FindFirstChild("RightUpperArm")
    local leftLeg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftFoot") or character:FindFirstChild("LeftLowerLeg")
    local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightFoot") or character:FindFirstChild("RightLowerLeg")
    local n = 0
    if head and torso then n += 1; skP[n] = head; skP[n + 6] = torso end
    if torso and root then n += 1; skP[n] = torso; skP[n + 6] = root end
    if torso and leftArm then n += 1; skP[n] = torso; skP[n + 6] = leftArm end
    if torso and rightArm then n += 1; skP[n] = torso; skP[n + 6] = rightArm end
    if root and leftLeg then n += 1; skP[n] = root; skP[n + 6] = leftLeg end
    if root and rightLeg then n += 1; skP[n] = root; skP[n + 6] = rightLeg end
    ESP._skCount = n
    return skP, n
end

local function ESPQuickVisibleCheck(point, originX, originY, originZ)
    local px, py, pz = point.X, point.Y, point.Z
    local dx, dy, dz = px - originX, py - originY, pz - originZ
    local mag = dx * dx + dy * dy + dz * dz
    if mag < 0.01 then return true end
    local dist = math.sqrt(mag)
    local dirX, dirY, dirZ = dx / dist, dy / dist, dz / dist
    local fromX, fromY, fromZ = originX, originY, originZ
    local remaining = dist
    while remaining > 0.25 do
        local result = workspace:Raycast(
            Vector3.new(fromX, fromY, fromZ),
            Vector3.new(dirX * remaining, dirY * remaining, dirZ * remaining),
            ESP.RayParams
        )
        if result == nil then
            return true
        end
        local hit = result.Instance
        local blocks = true
        if hit and hit:IsA("BasePart") and hit.Transparency >= 0.5 then
            blocks = false
        end
        if blocks then
            return false
        end
        local step = 0.5
        local hitPos = result.Position
        fromX = hitPos.X + dirX * step
        fromY = hitPos.Y + dirY * step
        fromZ = hitPos.Z + dirZ * step
        remaining = remaining - (result.Distance + step)
    end
    return false
end

local function ESPIsVisible(character, camera)
    if not character or not camera then return false end
    local cached = ESP.VisibilityCache[character]
    if cached and os.clock() < cached.expiresAt then
        return cached.value
    end
    local camPos = camera.CFrame.Position
    local ox, oy, oz = camPos.X, camPos.Y, camPos.Z
    ESP.RayParams.FilterDescendantsInstances = { lp.Character, character }

    local points = {}
    local head = ESPHitboxHead(character)
    local body = ESPHitboxBody(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if head and head:IsA("BasePart") then
        local hs = head.Size
        points[#points + 1] = head.Position + Vector3.new(0, hs.Y * 0.5, 0)
        points[#points + 1] = head.Position
    end
    if body and body:IsA("BasePart") then
        local bs = body.Size
        local halfW = math.max(bs.X, bs.Z) * 0.35
        local right = body.CFrame.RightVector
        points[#points + 1] = body.Position
        points[#points + 1] = body.Position + right * halfW
        points[#points + 1] = body.Position - right * halfW
        points[#points + 1] = body.Position - Vector3.new(0, bs.Y * 0.3, 0)
    end
    if hrp and hrp:IsA("BasePart") and hrp ~= body then
        points[#points + 1] = hrp.Position
    end

    local visible = false
    for i = 1, #points do
        if ESPQuickVisibleCheck(points[i], ox, oy, oz) then
            visible = true
            break
        end
    end

    ESP.VisibilityCache[character] = {
        value = visible,
        expiresAt = os.clock() + 0.15,
    }
    return visible
end

local function ESPLocalCorners(part)
    local cached = ESP.CornerCache[part]
    if cached and cached.size == part.Size then
        return cached.corners
    end
    local half = part.Size * 0.5
    local hx, hy, hz = half.X, half.Y, half.Z
    local cd = ESP._cd
    local idx = 0
    for xSign = -1, 1, 2 do
        for ySign = -1, 1, 2 do
            for zSign = -1, 1, 2 do
                idx += 1
                cd[idx] = Vector3.new(hx * xSign, hy * ySign, hz * zSign)
            end
        end
    end
    local corners = table.create(8)
    for i = 1, 8 do corners[i] = cd[i] end
    ESP.CornerCache[part] = { size = part.Size, corners = corners }
    return corners
end

local function ESPScreenBounds(character, camera)
    if not character or not camera then return nil end
    local pMinX, pMinY, pMaxX, pMaxY = 1e18, 1e18, -1e18, -1e18
    local pCount = 0

    local head = ESPHitboxHead(character)
    local body = ESPHitboxBody(character)

    local headOK = head and head:IsA("BasePart")
    local bodyOK = body and body:IsA("BasePart")

    if headOK then
        local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = head.CFrame:GetComponents()
        local corners = ESPLocalCorners(head)
        for ci = 1, 8 do
            local c = corners[ci]
            local cx, cy, cz = c.X, c.Y, c.Z
            local screen = camera:WorldToViewportPoint(Vector3.new(
                r00 * cx + r01 * cy + r02 * cz + px,
                r10 * cx + r11 * cy + r12 * cz + py,
                r20 * cx + r21 * cy + r22 * cz + pz
            ))
            if screen.Z > 0 then
                pCount += 1
                local sx, sy = screen.X, screen.Y
                if sx < pMinX then pMinX = sx end
                if sx > pMaxX then pMaxX = sx end
                if sy < pMinY then pMinY = sy end
                if sy > pMaxY then pMaxY = sy end
            end
        end
    end

    if bodyOK and body ~= head then
        local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = body.CFrame:GetComponents()
        local corners = ESPLocalCorners(body)
        for ci = 1, 8 do
            local c = corners[ci]
            local cx, cy, cz = c.X, c.Y, c.Z
            local screen = camera:WorldToViewportPoint(Vector3.new(
                r00 * cx + r01 * cy + r02 * cz + px,
                r10 * cx + r11 * cy + r12 * cz + py,
                r20 * cx + r21 * cy + r22 * cz + pz
            ))
            if screen.Z > 0 then
                pCount += 1
                local sx, sy = screen.X, screen.Y
                if sx < pMinX then pMinX = sx end
                if sx > pMaxX then pMaxX = sx end
                if sy < pMinY then pMinY = sy end
                if sy > pMaxY then pMaxY = sy end
            end
        end
    end

    if pCount < 2 or pMinX == 1e18 then return nil end
    return pMinX, pMinY, pMaxX, pMaxY
end

local function ESPSetSegment(segment, from, to, color, scale)
    if not segment or not segment.outline or not segment.color or not color then return end
    segment.outline.From = from
    segment.outline.To = to
    segment.outline.Color = ESP._FrameOutlineColor
    segment.outline.Thickness = scale
    segment.outline.Visible = true
    segment.color.From = from
    segment.color.To = to
    segment.color.Color = color
    segment.color.Thickness = ESP._OutlineScale1
    segment.color.Visible = true
end

local function ESPDrawBox(entry, minX, minY, maxX, maxY, color, scale)
    local width = maxX - minX
    if width < 1 then width = 1 end
    local height = maxY - minY
    if height < 1 then height = 1 end
    local half = width < height and width or height
    local length = half * 0.24
    if length < 5 * scale then length = 5 * scale end
    if length > width * 0.5 then length = width * 0.5 end
    if length > height * 0.5 then length = height * 0.5 end
    local corners = entry.corners
    ESPSetSegment(corners[1], Vector2.new(minX, minY), Vector2.new(minX + length, minY), color, scale)
    ESPSetSegment(corners[2], Vector2.new(maxX - length, minY), Vector2.new(maxX, minY), color, scale)
    ESPSetSegment(corners[3], Vector2.new(minX, maxY), Vector2.new(minX + length, maxY), color, scale)
    ESPSetSegment(corners[4], Vector2.new(maxX - length, maxY), Vector2.new(maxX, maxY), color, scale)
    ESPSetSegment(corners[5], Vector2.new(minX, minY), Vector2.new(minX, minY + length), color, scale)
    ESPSetSegment(corners[6], Vector2.new(maxX, minY), Vector2.new(maxX, minY + length), color, scale)
    ESPSetSegment(corners[7], Vector2.new(minX, maxY - length), Vector2.new(minX, maxY), color, scale)
    ESPSetSegment(corners[8], Vector2.new(maxX, maxY - length), Vector2.new(maxX, maxY), color, scale)
end

local function ESPDrawSkeleton(entry, character, camera, color, scale)
    local skelParts, skelCount = ESPGetSkeletonParts(character)
    local skeleton = entry.skeleton
    for i = 1, skelCount do
        local part1 = skelParts[i]
        local part2 = skelParts[i + 6]
        if part1 and part2 and part1:IsA("BasePart") and part2:IsA("BasePart") then
            local screen1 = camera:WorldToViewportPoint(part1.Position)
            local screen2 = camera:WorldToViewportPoint(part2.Position)
            if screen1.Z > 0 and screen2.Z > 0 then
                ESPSetSegment(skeleton[i], Vector2.new(screen1.X, screen1.Y), Vector2.new(screen2.X, screen2.Y), color, scale)
            else
                skeleton[i].outline.Visible = false
                skeleton[i].color.Visible = false
            end
        else
            skeleton[i].outline.Visible = false
            skeleton[i].color.Visible = false
        end
    end
    for i = skelCount + 1, 6 do
        skeleton[i].outline.Visible = false
        skeleton[i].color.Visible = false
    end
end

local function ESPDrawHealthBar(entry, minX, minY, maxY, humanoid)
    if not entry.healthBack or not entry.healthFill or not humanoid then return end
    local height = maxY - minY
    if height < 1 then height = 1 end
    local maxH = humanoid.MaxHealth
    if maxH < 1 then maxH = 1 end
    local fraction = humanoid.Health / maxH
    if fraction > 1 then fraction = 1 elseif fraction < 0 then fraction = 0 end
    local x = minX - 6
    entry.healthBack.Position = Vector2.new(x, minY)
    entry.healthBack.Size = Vector2.new(3, height)
    entry.healthBack.Color = ESP._FrameOutlineColor
    entry.healthBack.Visible = true
    local fillH = height * fraction
    entry.healthFill.Position = Vector2.new(x + 1, minY + height - fillH)
    entry.healthFill.Size = Vector2.new(1, fillH)
    entry.healthFill.Color = Color3.new(1 - fraction, fraction, 0.235)
    entry.healthFill.Visible = true
end

local function getFighters()
    if _G.EnemyRegistry then
        return _G.EnemyRegistry
    end
    if _G.Fighters then
        return _G.Fighters
    end
    if _G.fighters then
        return _G.fighters
    end
    return nil
end

local function getTeamId(player)
    local teamId = player:GetAttribute("TeamID")
    if teamId then return teamId end
    if player.Team then return player.Team.Name end
    return nil
end

local function isEnemy(player)
    local fighters = getFighters()
    if fighters then
        if fighters.byPlayer then
            local fighter = fighters.byPlayer[player]
            if fighter and fighter.isEnemy then
                return true
            end
            if fighter and fighter.isEnemy == false then
                return false
            end
        end
        if fighters.enemies then
            for _, fighter in pairs(fighters.enemies) do
                if fighter and fighter.player == player then
                    return true
                end
            end
        end
        if fighters.allies then
            for _, ally in pairs(fighters.allies) do
                if ally and ally.player == player then
                    return false
                end
            end
        end
    end

    local localTeamId = getTeamId(lp)
    local playerTeamId = getTeamId(player)
    if localTeamId and playerTeamId then
        return localTeamId ~= playerTeamId
    end

    local char = player.Character
    if char then
        if char:FindFirstChild("Enemy") or char:GetAttribute("IsEnemy") then
            return true
        end
        if char:FindFirstChild("Ally") or char:GetAttribute("IsAlly") then
            return false
        end
    end

    return true
end

local function ESPShouldDraw(player)
    if not player or player == lp then return false end
    if player.Parent ~= game:GetService("Players") then return false end
    if not ESP._cfg.ESPShowTeammates then
        if not isEnemy(player) then
            return false
        end
    end
    return true
end

local function ESPRender()
    local cfg = ESP._cfg
    if not cfg.ESPEnabled then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local camPos = camera.CFrame.Position
    local viewport = camera.ViewportSize
    local viewportY = viewport.Y
    local scale = viewportY / 1080
    if scale < 0.75 then scale = 0.75 elseif scale > 1.5 then scale = 1.5 end
    local outlineT = 0.75 * scale
    if outlineT < 0.5 then outlineT = 0.5 end
    local colorT = 1 * scale
    if colorT < 1 then colorT = 1 end
    ESP._FrameOutlineColor = Color3.fromRGB(cfg.ESPOutlineColor[1], cfg.ESPOutlineColor[2], cfg.ESPOutlineColor[3])
    ESP._FrameTextColor = Color3.fromRGB(cfg.ESPTextColor[1], cfg.ESPTextColor[2], cfg.ESPTextColor[3])
    ESP._FrameOutlineColor = ESP._FrameOutlineColor
    ESP._OutlineScale15 = outlineT
    ESP._OutlineScale1 = colorT
    ESP._TextScale = cfg.ESPTextSize

    local localCharacter = lp.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

    local espEnabled = cfg.ESPEnabled
    local espShowTeam = cfg.ESPShowTeammates
    local espMaxDist = cfg.ESPMaxDistance
    local espBox = cfg.ESPBox
    local espNames = cfg.ESPNames
    local espDist = cfg.ESPDistance
    local espHealthText = cfg.ESPHealthText
    local espHealthBar = cfg.ESPHealthBar
    local espLookDir = cfg.ESPLookDirection
    local espSkeleton = cfg.ESPSkeleton
    local textSize = cfg.ESPTextSize * scale

    local textColor = ESP._FrameTextColor
    local outlineColor = ESP._FrameOutlineColor
    local function safeColor(key, r, g, b)
        local v = cfg[key]
        if type(v) == "table"
            and type(v[1]) == "number" and type(v[2]) == "number" and type(v[3]) == "number" then
            local ok, c = pcall(Color3.fromRGB, v[1], v[2], v[3])
            if ok and c then
                return c
            end
        end
        return Color3.fromRGB(r, g, b)
    end
    local visColor = safeColor("ESPVisibleColor", 0, 255, 38)
    local hidColor = safeColor("ESPHiddenColor", 255, 0, 0)
    local teamColor = safeColor("ESPTeammateColor", 0, 132, 255)

    local minDist = espMaxDist * espMaxDist

    for player, entry in next, ESP.Entries do
        local drawn = false
        local ok, err = pcall(function()
            if espEnabled and ESPShouldDraw(player) then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local body = character and ESPHitboxBody(character)

                if humanoid and humanoid.Health > 0 and body and body:IsA("BasePart") then
                    local bodyPos = body.Position
                    local dx = bodyPos.X - camPos.X
                    local dy = bodyPos.Y - camPos.Y
                    local dz = bodyPos.Z - camPos.Z
                    local distSq = dx * dx + dy * dy + dz * dz
                    if distSq <= minDist then
                        local distance = math.sqrt(distSq)
                        local visible = ESPIsVisible(character, camera)
                        local color
                        local enemyStatus = isEnemy(player)
                        if enemyStatus then
                            color = (visible and visColor) or hidColor or visColor
                        else
                            color = teamColor or visColor
                        end
                        local minX, minY, maxX, maxY = ESPScreenBounds(character, camera)
                        if minX then
                            drawn = true
                            if espBox then
                                ESPDrawBox(entry, minX, minY, maxX, maxY, color, outlineT)
                            else
                                local corners = entry.corners
                                for ci = 1, 8 do
                                    corners[ci].outline.Visible = false
                                    corners[ci].color.Visible = false
                                end
                            end
                            if espNames then
                                entry.name.Text = player.DisplayName
                                entry.name.Size = textSize
                                entry.name.Color = textColor
                                entry.name.Position = Vector2.new((minX + maxX) * 0.5, minY - 16 * scale)
                                entry.name.Visible = true
                            else
                                entry.name.Visible = false
                            end
                            local needsInfo = espDist or espHealthText
                            if needsInfo then
                                local txt
                                if espDist and espHealthText then
                                    txt = math.floor(distance) .. "m  " .. math.floor(humanoid.Health) .. " hp"
                                elseif espDist then
                                    txt = math.floor(distance) .. "m"
                                else
                                    txt = math.floor(humanoid.Health) .. " hp"
                                end
                                entry.info.Text = txt
                                entry.info.Size = textSize
                                entry.info.Color = textColor
                                entry.info.Position = Vector2.new((minX + maxX) * 0.5, maxY + 2 * scale)
                                entry.info.Visible = true
                            else
                                entry.info.Visible = false
                            end
                            if espHealthBar then
                                ESPDrawHealthBar(entry, minX, minY, maxY, humanoid)
                            else
                                entry.healthBack.Visible = false
                                entry.healthFill.Visible = false
                            end
                            if espLookDir then
                                local head = ESPHitboxHead(character)
                                local fromPart = head or body
                                local fromPos = fromPart.Position
                                local lookVec = fromPart.CFrame.LookVector
                                local toPos = fromPos + lookVec * 6
                                local a = camera:WorldToViewportPoint(fromPos)
                                local b = camera:WorldToViewportPoint(toPos)
                                if a.Z > 0 and b.Z > 0 then
                                    local fromPoint = Vector2.new(a.X, a.Y)
                                    local toPoint = Vector2.new(b.X, b.Y)
                                    entry.lookOutline.From = fromPoint
                                    entry.lookOutline.To = toPoint
                                    entry.lookOutline.Color = color
                                    entry.lookOutline.Thickness = outlineT
                                    entry.lookOutline.Visible = true
                                    entry.look.From = fromPoint
                                    entry.look.To = toPoint
                                    entry.look.Color = color
                                    entry.look.Thickness = colorT
                                    entry.look.Visible = true
                                else
                                    entry.look.Visible = false
                                    entry.lookOutline.Visible = false
                                end
                            else
                                entry.look.Visible = false
                                entry.lookOutline.Visible = false
                            end
                            if espSkeleton then
                                ESPDrawSkeleton(entry, character, camera, color, outlineT)
                            else
                                local skel = entry.skeleton
                                for si = 1, 6 do
                                    skel[si].outline.Visible = false
                                    skel[si].color.Visible = false
                                end
                            end
                        end
                    end
                end
            end
        end)
        if not ok then
            warn("[ESP] Error rendering player " .. tostring(player.Name) .. ": " .. tostring(err))
        end
        if not drawn then
            ESPHideEntry(entry)
        end
    end
end

local ESPRenderConn
local ESPAddedConn
local ESPRemovingConn

local function ESPStart()
    if ESPRenderConn then return end
    local Plrs = game:GetService("Players")
    for _, player in ipairs(Plrs:GetPlayers()) do
        if player ~= lp then
            ESP.Entries[player] = ESPCreateEntry()
        end
    end
    ESPAddedConn = Plrs.PlayerAdded:Connect(function(player)
        ESP.Entries[player] = ESPCreateEntry()
    end)
    ESPRemovingConn = Plrs.PlayerRemoving:Connect(function(player)
        local entry = ESP.Entries[player]
        if entry then
            ESPDestroyEntry(entry)
            ESP.Entries[player] = nil
        end
    end)
    ESPRenderConn = RunService.RenderStepped:Connect(function()
        local ok, err = pcall(ESPRender)
        if not ok then
            warn("[ESP] " .. tostring(err))
        end
    end)
end

local function ESPStop()
    if not ESPRenderConn then return end
    pcall(function() ESPRenderConn:Disconnect() end)
    pcall(function() ESPAddedConn:Disconnect() end)
    pcall(function() ESPRemovingConn:Disconnect() end)
    for player, entry in pairs(ESP.Entries) do
        ESPDestroyEntry(entry)
        ESP.Entries[player] = nil
    end
    ESPRenderConn = nil
    ESPAddedConn = nil
    ESPRemovingConn = nil
end

