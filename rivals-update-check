local function waitForGameLoaded()
    local loadStart = tick()
    repeat
        task.wait()
        local pg = lp.PlayerGui
        if not pg then continue end
        local loading = pg:FindFirstChild("LoadingScreen")
        if loading then continue end
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if not workspace.CurrentCamera then continue end
        local mainGui = pg:FindFirstChild("MainGui")
        if not mainGui then continue end
        local mainFrame = mainGui:FindFirstChild("MainFrame")
        if not mainFrame then continue end
        local lobby = mainFrame:FindFirstChild("Lobby")
        if not lobby then continue end
        local rs = game:GetService("ReplicatedStorage")
        local remotes = rs:FindFirstChild("Remotes")
        if not remotes then continue end
        local data = remotes:FindFirstChild("Data")
        if not data then continue end
        local replication = remotes:FindFirstChild("Replication")
        if not replication then continue end
        local fighterRemote = replication:FindFirstChild("Fighter")
        if not fighterRemote then continue end
        local ps = lp:FindFirstChild("PlayerScripts")
        local controllers = ps and ps:FindFirstChild("Controllers")
        if not controllers then continue end
        if not controllers:FindFirstChild("FighterController") then continue end
        if not controllers:FindFirstChild("PlayerDataController") then continue end
        if not controllers:FindFirstChild("LobbyController") then continue end
        task.wait(2)
        return true
    until tick() - loadStart > 30
    return false
end

