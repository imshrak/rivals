function NativeRemovals.RequireModule(key)
    if NativeRemovals.Modules[key] then return NativeRemovals.Modules[key] end
    local path = NativeRemovals.ModulePaths[key]
    if not path then return nil end
    local cursor = lp:FindFirstChild("PlayerScripts")
    if not cursor then return nil end
    for _, seg in ipairs(path) do
        cursor = cursor:FindFirstChild(seg)
        if not cursor then return nil end
    end
    local ok, mod = pcall(require, cursor)
    if ok and type(mod) == "table" then
        NativeRemovals.Modules[key] = mod
        return mod
    end
    return nil
end

function NativeRemovals.ReadConstant(fn, index)
