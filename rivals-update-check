if Utility and RaycastFunc then
    local screenCenter = Vector2.zero
    local function getTarget()
        local config = getgenv().Config
        if math.random(1, 100) > config.HitChance then
            return nil
        end
        local entities = getEntities()
        local target = nil
        local closestDistance = config.FOVRadius
        screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not localRoot then
            return nil
        end
        local origin = localRoot.Position
        local maxDist = MAX_DISTANCE
        local wallCheck = config.WallCheck
        local hitPartChoice = config.HitPart
        local isRandom = hitPartChoice == "Random"
        local isBody = hitPartChoice == "Body"
        local partToFind = isRandom or isBody and "HumanoidRootPart" or hitPartChoice

        for i = 1, #entities do
            local entity = entities[i]
            if entity == LocalPlayer.Character then continue end
            local player = Players:GetPlayerFromCharacter(entity)
            if player and not isEnemy(player) then continue end
            if not isAlive(entity) then continue end
            local hitPart
            if isRandom then
                local randomPart = BodyParts[math.random(1, #BodyParts)]
                hitPart = entity:FindFirstChild(randomPart)
            elseif isBody then
                hitPart = entity:FindFirstChild("HumanoidRootPart")
            else
                hitPart = entity:FindFirstChild(partToFind)
            end
            if not hitPart or not hitPart:IsA("BasePart") then continue end
            local hitPos = hitPart.Position
            local dist = (hitPos - origin).Magnitude
            if dist > maxDist then continue end
            local screenPos, onScreen = Camera:WorldToViewportPoint(hitPos)
            if not onScreen then continue end
            local screenDist = (screenCenter.X - screenPos.X) ^ 2 + (screenCenter.Y - screenPos.Y) ^ 2
            if screenDist < closestDistance ^ 2 then
                if wallCheck then
                    if isTargetVisible(origin, hitPart) then
                        closestDistance = math.sqrt(screenDist)
                        target = hitPart
                    end
                else
                    closestDistance = math.sqrt(screenDist)
                    target = hitPart
                end
            end
        end
        return target
    end

    Utility.Raycast = function(self, origin, direction, maxDistance, raycastParams, whitelist, blacklist)
        local override = SilentAimOverrideTarget
        if override then
            if not override:IsA("BasePart") or not override.Parent then
                SilentAimOverrideTarget = nil
                override = nil
            end
        end
        if not SilentAimEnabled or not isScoped() then
            return RaycastFunc(self, origin, direction, maxDistance, raycastParams, whitelist, blacklist)
        end
        if not override and not isFirstPerson() then
            return RaycastFunc(self, origin, direction, maxDistance, raycastParams, whitelist, blacklist)
        end
        if type(maxDistance) ~= "number" or maxDistance < 100 then
            return RaycastFunc(self, origin, direction, maxDistance, raycastParams, whitelist, blacklist)
        end
        local target
        if override then
            if math.random(1, 100) <= (getgenv().Config.HitChance or 67) then
                target = override
            end
        else
            target = getTarget()
        end
        if not target then
            return RaycastFunc(self, origin, direction, maxDistance, raycastParams, whitelist, blacklist)
        end
        local targetPosition = target.Position
        local targetDirection = (targetPosition - origin).Unit
        local targetDistance = (targetPosition - origin).Magnitude
        if targetDistance > maxDistance then
            targetDistance = maxDistance
            targetPosition = origin + (targetDirection * maxDistance)
        end
        return {
            Position = targetPosition,
            Distance = targetDistance,
            Instance = target,
            Material = target.Material,
            Normal = -targetDirection
        }
    end
end

