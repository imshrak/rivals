local function getAimTarget()
    local config = getgenv().Config
    local entities = getEntities()
    local best = nil
    local bestScore = nil
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position
    local fov = config.FOVRadius
    local wallCheck = config.WallCheck
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    for i = 1, #entities do
        local entity = entities[i]
        if entity == LocalPlayer.Character then continue end
        local player = Players:GetPlayerFromCharacter(entity)
        if player and not isEnemy(player) then continue end
        if not isAlive(entity) then continue end
        local part = getHitPart(entity)
        if not part or not part:IsA("BasePart") then continue end
        local dist = (part.Position - localRoot.Position).Magnitude
        if dist > MAX_DISTANCE then continue end
        local v, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen or v.Z <= 0 then continue end
        local d = (Vector2.new(v.X, v.Y) - center).Magnitude
        if d > fov then continue end
        if wallCheck and not isTargetVisible(camPos, part) then continue end
        local score = d + dist * 0.02
        if not bestScore or score < bestScore then
            bestScore = score
            best = part
        end
    end
    return best
end

local function getLockedTarget()
    if aimbotPart and aimbotPart.Parent then
        local holder = aimbotPart.Parent
        local player = Players:GetPlayerFromCharacter(holder)
        local keep = true
        if (player and not isEnemy(player)) or not isAlive(holder) then
            keep = false
        elseif not aimbotPart:IsA("BasePart") then
            keep = false
        else
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not root or (aimbotPart.Position - root.Position).Magnitude > MAX_DISTANCE then
                keep = false
            else
                local v, onScreen = Camera:WorldToViewportPoint(aimbotPart.Position)
                if not onScreen or v.Z <= 0 then
                    keep = false
                else
                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                    if d > getgenv().Config.FOVRadius * 1.4 then
                        keep = false
                    elseif getgenv().Config.WallCheck and not isTargetVisible(Camera.CFrame.Position, aimbotPart) then
                        keep = false
                    end
                end
            end
        end
        if keep then return aimbotPart end
        aimbotPart = nil
    end
    aimbotPart = getAimTarget()
    return aimbotPart
end

local function wrapAngle(a)
    local TWO_PI = math.pi * 2
    return ((a + math.pi) % TWO_PI) - math.pi
end

local function onAimbotFrame(dt)
    if not AimbotEnabled then return end
    if not cameraController then return end
    if not isFirstPerson() then return end
    if not isScoped() then
        aimbotPart = nil
        return
    end
    local target = getLockedTarget()
    if not target then return end
    Camera = workspace.CurrentCamera
    if not Camera then return end
    local camCFrame = cameraController:GetCameraCFrame()
    if not camCFrame then return end
    local dir = (target.Position - camCFrame.Position).Unit
    local desiredYaw = math.atan2(-dir.X, -dir.Z)
    local desiredPitch = math.asin(math.clamp(dir.Y, -1, 1))
    local base = cameraController.Rotation or Vector2.zero
    local dyaw = wrapAngle(desiredYaw - base.Y)
    local dpitch = desiredPitch - base.X
    local smooth = math.clamp(getgenv().Config.AimbotSmoothness, 1, 100)
    local p = 0.02 + (1 - smooth / 100) * 0.6
    local alpha = 1 - math.pow(1 - p, dt * 60)
    if alpha > 1 then alpha = 1 end
    cameraController:SetRotation(Vector2.new(base.X + dpitch * alpha, base.Y + dyaw * alpha))
end

